{
  "name": "sidshub-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "lexical": "0.41.0",
    "@lexical/*": "0.41.0"
  },
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --filter @sidshub/web dev",
    "dev:cms": "bun run --filter @sidshub/cms dev",
    "build": "turbo run build --filter=@sidshub/web --filter=@sidshub/cms",
    "build:web": "turbo run build --filter=@sidshub/web",
    "build:test:web": "turbo run build:test --filter=@sidshub/web",
    "build:cms": "turbo run build --filter=@sidshub/cms",
    "check:web": "turbo run check --filter=@sidshub/web",
    "payload:types": "turbo run generate:types --filter=@sidshub/cms",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "precommit": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run precommit",
    "commit-msg": "bun run commitlint --edit $1"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,jsx,ts,tsx,cjs,mjs,astro}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,yaml,yml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.24.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.5.8"
  }
}
