{
  "name": "sidshub-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --filter @sidshub/web dev",
    "dev:cms": "bun run --filter @sidshub/cms dev",
    "build": "bun run build:web && bun run build:cms",
    "build:web": "bun run --filter @sidshub/web build",
    "build:cms": "bun run --filter @sidshub/cms build",
    "check:web": "bun run --filter @sidshub/web check",
    "payload:types": "bun run --filter @sidshub/cms generate:types"
  }
}
