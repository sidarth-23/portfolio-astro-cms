{
  "name": "@sidshub/web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "ASTRO_BUILD_CACHE_GLOBALS=true astro check && ASTRO_BUILD_CACHE_GLOBALS=true astro build",
    "build:test": "ASTRO_BUILD_CACHE_GLOBALS=true ASTRO_MOCK_CMS=true ASTRO_CMS_READ_TOKEN=mock ASTRO_CMS_API_URL=http://mock astro check && ASTRO_BUILD_CACHE_GLOBALS=true ASTRO_MOCK_CMS=true ASTRO_CMS_READ_TOKEN=mock ASTRO_CMS_API_URL=http://mock astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/node": "^9.1.3",
    "@astrojs/rss": "4.0.11",
    "@astrojs/sitemap": "3.3.1",
    "@astrojs/tailwind": "6.0.2",
    "@sidshub/cms-core": "workspace:*",
    "@sidshub/cms-lib-editor": "workspace:*",
    "@sidshub/cms-lib-icons": "workspace:*",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "5.7.5",
    "phosphor-icons-astro": "^2.1.1-17042025",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@sidshub/dev-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.15",
    "daisyui": "^5.5.5",
    "eslint": "^9.24.0"
  }
