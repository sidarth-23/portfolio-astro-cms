---
import EntryHeader from "@/components/EntryHeader.astro";
import DetailLayout from "@/layouts/DetailLayout.astro";
import { resolveIconSvg } from "@sidshub/cms-lib-icons";
import type { TableOfContentsItem } from "@sidshub/cms-lib-editor/web/html";
import type { ProjectLink } from "@sidshub/cms-core/client";
import type { Media } from "@sidshub/cms-core/payload-types";
import type { TagInfo } from "@/lib/cms";

type Props = {
  title: string;
  seoTitle: string;
  seoDescription: string;
  image?: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroMedia?: Media | string | number | null;
  tags?: TagInfo[];
  badges?: string[];
  links?: ProjectLink[];
  toc?: TableOfContentsItem[];
  backHref?: string;
  backLabel?: string;
  createdAt: string;
  updatedAt: string;
};

const {
  title,
  seoTitle,
  seoDescription,
  image,
  heroImage,
  heroImageAlt,
  heroMedia,
  tags = [],
  badges = [],
  links = [],
  toc = [],
  backHref,
  backLabel,
  createdAt,
  updatedAt,
}: Props = Astro.props;

const displayDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(new Date(createdAt));

const createdDateOnly = new Date(createdAt).toDateString();
const updatedDateOnly = new Date(updatedAt).toDateString();
const showUpdatedDate = updatedDateOnly !== createdDateOnly;
const formattedUpdatedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(new Date(updatedAt));
const resolvedLinks = (
  await Promise.all(
    links.map(async (link) => {
      const iconData = resolveIconSvg(link.icon);
      if (!iconData) {
        return null;
      }

      return {
        ...link,
        iconData,
      };
    }),
  )
).filter(
  (entry): entry is ProjectLink & { iconData: NonNullable<ReturnType<typeof resolveIconSvg>> } =>
    entry !== null,
);
---

<DetailLayout
  title={title}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  image={image}
  heroImage={heroImage}
  heroImageAlt={heroImageAlt}
  heroMedia={heroMedia}
  toc={toc}
  backHref={backHref}
  backLabel={backLabel}
>
  <EntryHeader slot="header" title={title} tags={tags}>
    <Fragment slot="preTitle">
      {
        badges.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {badges.map((badge) => (
              <span class="badge badge-accent badge-outline">{badge}</span>
            ))}
          </div>
        )
      }
    </Fragment>

    <Fragment slot="titleActions">
      {
        resolvedLinks.map((link) => {
          const { iconData } = link;
          return (
            <a
              href={link.url}
              target={link.newTab ? "_blank" : undefined}
              rel={link.newTab ? "noopener noreferrer" : undefined}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-base-content/15 bg-base-200/40 text-base-content/60 transition-colors hover:text-base-content"
              aria-label={iconData.label}
              title={iconData.label}
            >
              <svg
                viewBox={iconData.viewBox}
                width={16}
                height={16}
                aria-hidden="true"
                class="h-4 w-4 fill-current stroke-current"
                set:html={iconData.innerSvg}
              />
            </a>
          );
        })
      }
    </Fragment>

    <Fragment slot="meta">
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-base-content/60">
        <span>
          Published <time datetime={createdAt}>{displayDate}</time>
        </span>
        {
          showUpdatedDate && (
            <>
              <span aria-hidden="true" class="text-base-content/35">
                •
              </span>
              <span>
                Updated <time datetime={updatedAt}>{formattedUpdatedDate}</time>
              </span>
            </>
          )
        }
      </div>
    </Fragment>
  </EntryHeader>

  <slot />
</DetailLayout>
