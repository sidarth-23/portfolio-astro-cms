---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import SideBar from "../components/SideBar.astro";
import { ClientRouter } from "astro:transitions";

import { TRANSITION_API } from "../consts";
import { getHomePage, getSiteSettings } from "@/lib/cms/client";

const {
  image,
  title,
  description,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  canonicalUrl,
  robotsIndex,
  robotsFollow,
  jsonLd,
} = Astro.props;

const [homePage, siteSettings] = await Promise.all([getHomePage(), getSiteSettings()]);

const siteTitle = siteSettings.siteTitle;
const siteDescription = siteSettings.siteDescription;
const pageTitle = title ?? siteTitle;
const pageDescription = description ?? siteDescription;
---

<!doctype html>
<html lang="en" data-theme="abyss">
  <head>
    <BaseHead
      title={`${siteTitle} | ${pageTitle}`}
      description={pageDescription}
      image={image}
      ogType={ogType}
      canonicalUrl={canonicalUrl}
      robotsIndex={robotsIndex}
      robotsFollow={robotsFollow}
      jsonLd={jsonLd}
    />
    {TRANSITION_API && <ClientRouter />}
  </head>

  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header name={homePage.name} />
        <div class="md:flex md:justify-center">
          <main class="p-6 pt-10 lg:max-w-[900px] max-w-[100vw]">
            <slot />
          </main>
        </div>
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
  </body>
</html>
