---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import SideBar from "../components/SideBar.astro";
import { ClientRouter } from "astro:transitions";
import { ASTRO_CMS_API_URL, ASTRO_CMS_READ_TOKEN } from "astro:env/server";
import { createCmsRestClient } from "@sidshub/cms-config/rest-client";
import type { HomePage, SiteSetting } from "@sidshub/cms-config/payload-types";

import { TRANSITION_API } from "../consts";

const cmsClient = createCmsRestClient({ apiUrl: ASTRO_CMS_API_URL, token: ASTRO_CMS_READ_TOKEN });

const {
  image,
  title,
  seoTitle,
  description,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  jsonLd,
} = Astro.props;

const [homePage, siteSettings]: [HomePage, SiteSetting] = await Promise.all([
  cmsClient.getHomePage(),
  cmsClient.getSiteSettings(),
]);

const fallbackTitle = typeof title === "string" ? title.trim() : "";
const seoPageTitle = typeof seoTitle === "string" ? seoTitle.trim() : "";
const pageTitle = seoPageTitle || fallbackTitle;
const pageDescription = typeof description === "string" ? description.trim() : "";

if (!pageTitle) {
  throw new Error("BaseLayout requires a non-empty SEO title via `seoTitle` or `title`.");
}

if (!pageDescription) {
  throw new Error("BaseLayout requires a non-empty SEO description via `description`.");
}

const profileImage = cmsClient.mediaToUrl(siteSettings.profileImage);
const footerItems = cmsClient.footerItemsFromSiteSettings(siteSettings);
const resumeDownloadUrl = siteSettings.resumeDownloadUrl?.trim() || undefined;
---

<!doctype html>
<html lang="en" data-theme="abyss">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      image={image}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    {TRANSITION_API && <ClientRouter />}
  </head>

  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header name={homePage.name} />
        <div class="md:flex md:justify-center w-full container px-6 py-14">
          <main class="container w-full max-w-4xl">
            <slot />
          </main>
        </div>
      </div>
      {
        includeSidebar && (
            <SideBar
              sideBarActiveItemID={sideBarActiveItemID}
              footerItems={footerItems}
              profileImage={profileImage}
              resumeDownloadUrl={resumeDownloadUrl}
            />
        )
      }
    </div>
  </body>
</html>
