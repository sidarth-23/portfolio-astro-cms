---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import SideBar from "../components/SideBar.astro";
import ThemePreloadScript from "../components/ThemePreloadScript.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { ClientRouter } from "astro:transitions";
import type { HomePage, SiteSetting } from "@sidshub/cms-core/payload-types";
import { cmsClient } from "../lib/cms";

import { TRANSITION_API } from "../consts";

type Props = {
  image?: string;
  title: string;
  seoTitle: string;
  description: string;
  includeSidebar?: boolean;
  ogType?: string;
  jsonLd?: unknown;
};

const {
  image,
  title,
  seoTitle,
  description,
  includeSidebar = true,
  ogType,
  jsonLd,
}: Props = Astro.props;

const [homePage, siteSettings]: [HomePage, SiteSetting] = await Promise.all([
  cmsClient.getHomePage(),
  cmsClient.getSiteSettings(),
]);

const pageTitle = seoTitle;
const pageDescription = description;

if (!pageTitle) {
  throw new Error(
    `BaseLayout requires a non-empty SEO title via \`seoTitle\` (page title: "${title}").`,
  );
}

if (!pageDescription) {
  throw new Error(
    "BaseLayout requires a non-empty SEO description via `description`.",
  );
}

const profileImage = cmsClient.mediaToUrl(siteSettings.profileImage);
const footerItems = cmsClient.footerItemsFromSiteSettings(siteSettings);
const resumeDownloadUrl = siteSettings.resumeDownloadUrl || undefined;
---

<!doctype html>
<html lang="en" data-theme="emerald">
  <head>
    <ThemePreloadScript />
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      image={image}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    {TRANSITION_API && <ClientRouter />}
  </head>

  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header name={homePage.name} />
        <div class="w-full px-6 pb-14 pt-6">
          <div
            class="mx-auto mb-4 hidden w-full max-w-5xl justify-end 2xl:max-w-6xl lg:flex"
          >
            <ThemeSwitcher />
          </div>
          <main class="mx-auto w-full max-w-5xl 2xl:max-w-6xl">
            <slot />
          </main>
        </div>
      </div>
      {
        includeSidebar && (
          <SideBar
            footerItems={footerItems}
            profileImage={profileImage}
            resumeDownloadUrl={resumeDownloadUrl}
          />
        )
      }
    </div>

  </body>
</html>
