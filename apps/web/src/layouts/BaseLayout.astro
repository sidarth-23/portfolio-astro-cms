---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import SideBar from "../components/SideBar.astro";
import { ClientRouter } from "astro:transitions";
import type { HomePage, SiteSetting } from "@sidshub/cms-config/payload-types";

import { TRANSITION_API } from "../consts";
import { footerItemsFromSiteSettings, getHomePage, getSiteSettings, mediaToUrl } from "@/lib/cms/client";

const {
  image,
  title,
  seoTitle,
  description,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  canonicalUrl,
  robotsIndex,
  robotsFollow,
  jsonLd,
} = Astro.props;

const [homePage, siteSettings]: [HomePage, SiteSetting] = await Promise.all([
  getHomePage(),
  getSiteSettings(),
]);

const siteTitle = siteSettings.meta?.title?.trim() || "Sid's Hub";
const siteDescription = siteSettings.meta?.description?.trim() || "Personal website and blog.";
const fallbackTitle = typeof title === "string" ? title.trim() : "";
const seoPageTitle = typeof seoTitle === "string" ? seoTitle.trim() : "";
const normalizedSeoPageTitle =
  fallbackTitle &&
    seoPageTitle.toLowerCase() === `${fallbackTitle.toLowerCase()} page`
    ? fallbackTitle
    : seoPageTitle;
const pageTitleSegment = fallbackTitle || siteTitle;
const resolvedHeadTitle = normalizedSeoPageTitle
  ? `${siteTitle} | ${normalizedSeoPageTitle}`
  : (pageTitleSegment.toLowerCase() === siteTitle.toLowerCase()
      ? siteTitle
      : `${siteTitle} | ${pageTitleSegment}`);
const pageDescription = description ?? siteDescription;
const pageImage = image ?? mediaToUrl(siteSettings.meta?.image);
const profileImage = mediaToUrl(siteSettings.profileImage);
const footerItems = footerItemsFromSiteSettings(siteSettings);
---

<!doctype html>
<html lang="en" data-theme="abyss">
  <head>
    <BaseHead
      title={resolvedHeadTitle}
      description={pageDescription}
      image={pageImage}
      ogType={ogType}
      canonicalUrl={canonicalUrl}
      robotsIndex={robotsIndex}
      robotsFollow={robotsFollow}
      jsonLd={jsonLd}
    />
    {TRANSITION_API && <ClientRouter />}
  </head>

  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header name={homePage.name} />
        <div class="md:flex md:justify-center w-full container px-6 py-14">
          <main class="container w-full max-w-4xl">
            <slot />
          </main>
        </div>
      </div>
      {
        includeSidebar && (
            <SideBar
              sideBarActiveItemID={sideBarActiveItemID}
              footerItems={footerItems}
              profileImage={profileImage}
            />
        )
      }
    </div>
  </body>
</html>
