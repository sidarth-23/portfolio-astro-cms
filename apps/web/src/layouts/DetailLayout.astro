---
import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PhList, PhX } from "phosphor-icons-astro";
import type { TableOfContentsItem } from "@sidshub/cms-editor/web/html";
import type { TagInfo } from "@sidshub/cms-core/client";

type Props = {
  title: string;
  seoTitle: string;
  description: string;
  image?: string;
  heroImage?: string;
  heroImageAlt?: string;
  tags?: TagInfo[];
  toc?: TableOfContentsItem[];
  backHref?: string;
  backLabel?: string;
  ogType?: string;
  jsonLd?: unknown;
  articleClassName?: string;
  showDescription?: boolean;
};

const {
  title,
  seoTitle,
  description,
  image,
  heroImage,
  heroImageAlt,
  tags = [],
  toc = [],
  backHref,
  backLabel,
  ogType,
  jsonLd,
  articleClassName = "prose prose-lg min-w-0 max-w-none prose-img:mx-auto",
  showDescription = true,
}: Props = Astro.props;

const tocDrawerId = "detail-toc-drawer";
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  image={image ?? heroImage}
  ogType={ogType}
  jsonLd={jsonLd}
>
  <div class="w-full px-6 py-14">
    <div class="drawer drawer-end xl:drawer-open">
      <input id={tocDrawerId} type="checkbox" class="drawer-toggle" />

      <div class="drawer-content">
        <div class="mx-auto w-full max-w-5xl 2xl:max-w-6xl">
          <div
            class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_18rem] 2xl:grid-cols-[minmax(0,1fr)_20rem]"
          >
            <article class="min-w-0">
              {
                backHref && backLabel && (
                  <div class="mb-6 not-prose">
                    <a
                      href={backHref}
                      class="text-sm font-medium text-base-content/60 transition-colors hover:text-base-content"
                    >
                      {backLabel}
                    </a>
                  </div>
                )
              }

              <slot name="headerStart" />

              {
                heroImage && (
                  <figure class="mb-8 flex w-full items-center justify-center rounded-3xl bg-base-200/30 shadow-sm not-prose">
                    <img
                      src={heroImage}
                      alt={heroImageAlt ?? title}
                      class="h-auto w-full rounded-2xl object-contain"
                      loading="eager"
                    />
                  </figure>
                )
              }

              <header class="mb-6 not-prose">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <h1 class="title my-2 text-4xl font-bold">{title}</h1>
                  <div class="flex flex-wrap items-center gap-2">
                    <slot name="titleActions" />
                  </div>
                </div>

                {
                  showDescription && (
                    <p class="mt-4 max-w-3xl text-lg leading-8 text-base-content/75">
                      {description}
                    </p>
                  )
                }

                <slot name="headerMeta" />

                {
                  tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      {tags.map((tag) => (
                        <span class="inline-flex items-center gap-1 rounded-full border border-base-content/12 bg-base-200/40 px-3 py-1 text-xs font-medium text-base-content/75">
                          <span class="text-base-content/30">#</span>
                          {tag.name}
                        </span>
                      ))}
                    </div>
                  )
                }
              </header>

              <div class="divider my-3"></div>

              <div class={articleClassName} data-toc-content>
                <slot />
              </div>
            </article>

            <aside class="hidden xl:block">
              <div
                class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto border-l border-base-content/20 pl-6 2xl:pl-8"
              >
                <TableOfContents items={toc} />
              </div>
            </aside>
          </div>
        </div>
      </div>

      <div class="drawer-side z-50 xl:hidden" data-toc-drawer>
        <label for={tocDrawerId} aria-label="Close table of contents" class="drawer-overlay"
        ></label>

        <div
          class="min-h-full w-80 max-w-[85vw] border-l border-base-content/20 bg-base-200/95 p-4 backdrop-blur"
        >
          <div class="mb-4 flex items-center justify-between gap-4">
            <div class="text-lg font-semibold">Table of contents</div>

            <label
              for={tocDrawerId}
              class="btn btn-square btn-ghost"
              aria-label="Close table of contents"
            >
              <PhX size={18} />
            </label>
          </div>

          <div class="border-l border-base-content/20 pl-5">
            <TableOfContents items={toc} />
          </div>
        </div>
      </div>
    </div>

    <label
      for={tocDrawerId}
      class="btn btn-circle btn-primary fixed bottom-6 right-6 z-40 shadow-lg xl:hidden"
      aria-label="Open table of contents"
    >
      <PhList size={20} />
    </label>
  </div>

  <script>
    import {
      initCodeBlocks,
      initImageGallery,
      initTableOfContents,
    } from "@sidshub/cms-editor/web/html/client";

    const DETAIL_TOC_DRAWER_ID = "detail-toc-drawer";
    let cleanupCodeBlocks = () => {};
    let cleanupImageGallery = () => {};
    let cleanupTableOfContents = () => {};

    const initializeCodeBlocks = () => {
      cleanupCodeBlocks();
      cleanupCodeBlocks = initCodeBlocks();
    };

    const initializeImageGallery = () => {
      cleanupImageGallery();
      cleanupImageGallery = initImageGallery();
    };

    const initializeTableOfContents = () => {
      cleanupTableOfContents();
      cleanupTableOfContents = initTableOfContents({
        onLinkClick: () => {
          const drawer = document.getElementById(DETAIL_TOC_DRAWER_ID);
          if (drawer instanceof HTMLInputElement) {
            drawer.checked = false;
          }
        },
      });
    };

    initializeCodeBlocks();
    initializeImageGallery();
    initializeTableOfContents();

    if (!document.documentElement.dataset.codeBlockPageLoadBound) {
      document.addEventListener("astro:page-load", initializeCodeBlocks);
      document.documentElement.dataset.codeBlockPageLoadBound = "true";
    }

    if (!document.documentElement.dataset.imageGalleryPageLoadBound) {
      document.addEventListener("astro:page-load", initializeImageGallery);
      document.documentElement.dataset.imageGalleryPageLoadBound = "true";
    }

    if (!document.documentElement.dataset.detailTocPageLoadBound) {
      document.addEventListener("astro:page-load", initializeTableOfContents);
      document.documentElement.dataset.detailTocPageLoadBound = "true";
    }
  </script>
</BaseLayout>
