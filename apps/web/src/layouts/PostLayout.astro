---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { generateFilterUrl } from "@/lib/utils";

type Tag = { name: string; slug: string };
type Category = { name: string; slug: string };
type Series = { name: string; slug: string };
type Author = { id?: number | null; name?: string | null };

type Props = {
  title: string;
  seoTitle?: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  heroImage?: string;
  badge?: string;
  tags?: Tag[];
  category?: Category;
  series?: Series;
  authors?: Author[];
};

const {
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  category,
  series,
  authors = [],
} = Astro.props;

const currentUrl = Astro.url;

const displayDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(new Date(pubDate));
const authorNames = authors
  .map((author) => author.name)
  .filter((name): name is string => Boolean(name));

const pubDateOnly = new Date(pubDate).toDateString();
const updatedDateOnly = updatedDate
  ? new Date(updatedDate).toDateString()
  : null;
const showUpdatedDate = updatedDateOnly && updatedDateOnly !== pubDateOnly;
const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }).format(new Date(updatedDate))
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: heroImage ? [new URL(heroImage, Astro.url).toString()] : undefined,
  datePublished: new Date(pubDate).toISOString(),
  dateModified: updatedDate
    ? new Date(updatedDate).toISOString()
    : new Date(pubDate).toISOString(),
  mainEntityOfPage: Astro.url.toString(),
};
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  image={heroImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <main class="w-full px-6 py-14">
    <article class="mx-auto prose prose-lg max-w-[750px] prose-img:mx-auto">
      {
        (category || series) && (
          <div class="flex flex-wrap gap-2 mb-4">
            {category && (
              <a
                href={generateFilterUrl(currentUrl, "category", category.slug)}
                class="badge badge-accent no-underline"
              >
                {category.name}
              </a>
            )}
            {series && (
              <a
                href={`/blog/series/${series.slug}`}
                class="badge badge-secondary no-underline"
              >
                {series.name}
              </a>
            )}
          </div>
        )
      }
      {
        heroImage && (
          <img
            src={heroImage}
            alt={title}
            class="w-full mb-6 rounded-lg"
            loading="eager"
          />
        )
      }
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {
        authorNames.length > 0 && (
          <div class="text-sm mt-1">By {authorNames.join(", ")}</div>
        )
      }
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="text-sm opacity-70">
          <time>{displayDate}</time>
          {
            showUpdatedDate && (
              <span>
                {" "}
                (updated <time>{formattedUpdatedDate}</time>)
              </span>
            )
          }
        </div>
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1">
              {tags.map((tag) => (
                <a
                  href={generateFilterUrl(currentUrl, "tag", tag.slug)}
                  class="badge badge-outline badge-sm no-underline opacity-70"
                >
                  {tag.name}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <div class="divider my-2"></div>
      <slot />
    </article>
  </main>
</BaseLayout>
