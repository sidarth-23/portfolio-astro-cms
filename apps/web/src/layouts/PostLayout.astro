---
import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { generateFilterUrl } from "@/lib/utils";
import { PhList, PhX } from "phosphor-icons-astro";
import type { TableOfContentsItem } from "@sidshub/lexical/web";

type Tag = { name: string; slug: string };
type Category = { name: string; slug: string };
type Series = { name: string; slug: string };
type Author = { id?: number | null; name?: string | null };

type Props = {
  title: string;
  seoTitle: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  heroImage?: string;
  badge?: string;
  tags?: Tag[];
  category?: Category;
  series?: Series;
  authors?: Author[];
  toc?: TableOfContentsItem[];
};

const {
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  category,
  series,
  authors = [],
  toc = [],
}: Props = Astro.props;

const currentUrl = Astro.url;
const showTableOfContents = toc.length > 1;

const displayDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(new Date(pubDate));
const authorNames = authors
  .map((author) => author.name)
  .filter((name): name is string => Boolean(name));

const pubDateOnly = new Date(pubDate).toDateString();
const updatedDateOnly = updatedDate
  ? new Date(updatedDate).toDateString()
  : null;
const showUpdatedDate = updatedDateOnly && updatedDateOnly !== pubDateOnly;
const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }).format(new Date(updatedDate))
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: heroImage ? [new URL(heroImage, Astro.url).toString()] : undefined,
  datePublished: new Date(pubDate).toISOString(),
  dateModified: updatedDate
    ? new Date(updatedDate).toISOString()
    : new Date(pubDate).toISOString(),
  mainEntityOfPage: Astro.url.toString(),
};
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  image={heroImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="w-full px-6 py-14">
    <div class={`drawer drawer-end ${showTableOfContents ? "xl:drawer-open" : ""}`.trim()}>
      {showTableOfContents && <input id="post-toc-drawer" type="checkbox" class="drawer-toggle" />}

      <div class="drawer-content">
        <div class="mx-auto w-full max-w-5xl 2xl:max-w-6xl">
          <div class={`grid gap-12 ${showTableOfContents ? "xl:grid-cols-[minmax(0,1fr)_18rem] 2xl:grid-cols-[minmax(0,1fr)_20rem]" : ""}`.trim()}>
            <article class="prose prose-lg min-w-0 max-w-none prose-img:mx-auto" data-toc-content>
              {
                (category || series) && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {category && (
                      <a
                        href={generateFilterUrl(currentUrl, "category", category.slug)}
                        class="badge badge-accent no-underline"
                      >
                        {category.name}
                      </a>
                    )}
                    {series && (
                      <a
                        href={`/blog/series/${series.slug}`}
                        class="badge badge-secondary no-underline"
                      >
                        {series.name}
                      </a>
                    )}
                  </div>
                )
              }
              {
                heroImage && (
                  <img
                    src={heroImage}
                    alt={title}
                    class="w-full mb-6 rounded-lg"
                    loading="eager"
                  />
                )
              }
              <h1 class="title my-2 text-4xl font-bold">{title}</h1>
              {
                authorNames.length > 0 && (
                  <div class="text-sm mt-1">By {authorNames.join(", ")}</div>
                )
              }
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="text-sm opacity-70">
                  <time>{displayDate}</time>
                  {
                    showUpdatedDate && (
                      <span>
                        {" "}
                        (updated <time>{formattedUpdatedDate}</time>)
                      </span>
                    )
                  }
                </div>
                {
                  tags.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {tags.map((tag) => (
                        <a
                          href={generateFilterUrl(currentUrl, "tag", tag.slug)}
                          class="badge badge-outline badge-sm no-underline opacity-70"
                        >
                          {tag.name}
                        </a>
                      ))}
                    </div>
                  )
                }
              </div>
              <div class="divider my-2"></div>
              <slot />
            </article>

            {
              showTableOfContents && (
                <aside class="hidden xl:block">
                  <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto border-l border-base-200/50 pl-6 2xl:pl-8">
                    <TableOfContents items={toc} />
                  </div>
                </aside>
              )
            }
          </div>
        </div>
      </div>

      {
        showTableOfContents && (
          <div class="drawer-side z-50 xl:hidden" data-toc-drawer>
            <label for="post-toc-drawer" aria-label="Close table of contents" class="drawer-overlay"></label>

            <div class="min-h-full w-80 max-w-[85vw] border-l border-base-200/50 bg-base-200/95 p-4 backdrop-blur">
              <div class="mb-4 flex items-center justify-between gap-4">
                <div class="text-lg font-semibold">Table of contents</div>

                <label for="post-toc-drawer" class="btn btn-square btn-ghost" aria-label="Close table of contents">
                  <PhX size={18} />
                </label>
              </div>

              <div class="border-l border-base-200/50 pl-5">
                <TableOfContents items={toc} />
              </div>
            </div>
          </div>
        )
      }
    </div>

    {
      showTableOfContents && (
        <label
          for="post-toc-drawer"
          class="btn btn-circle btn-primary fixed bottom-6 right-6 z-40 shadow-lg xl:hidden"
          aria-label="Open table of contents"
        >
          <PhList size={20} />
        </label>
      )
    }
  </div>

  <script is:inline>
    const initializeCodeBlocks = () => {
      // Tab switching for multi-tab code blocks
      document.querySelectorAll("[data-code-tabs]").forEach((container) => {
        const tabs = Array.from(container.querySelectorAll("[data-tab-index]"));
        const panels = Array.from(container.querySelectorAll("[data-tab-panel]"));

        const tabsContainer = container.querySelector("[data-tabs-container]");
        const dropdown = container.querySelector("[data-tabs-dropdown]");
        const dropdownList = container.querySelector("[data-tabs-dropdown-list]");

        if (dropdownList) {
          tabs.forEach(tab => {
            const index = tab.dataset.tabIndex;
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.textContent = tab.textContent;
            a.dataset.dropdownIndex = index;
            if (tab.getAttribute("aria-selected") === "true") {
              a.classList.add("active");
            }
            li.appendChild(a);
            dropdownList.appendChild(li);
          });
        }

        const activateTab = (index) => {
          tabs.forEach((t) => {
            const isActive = t.dataset.tabIndex === String(index);
            t.setAttribute("aria-selected", isActive ? "true" : "false");
            t.classList.toggle("tab-active", isActive);
            t.classList.toggle("font-medium", isActive);
            t.classList.toggle("font-normal", !isActive);
          });
          panels.forEach((p) => {
            p.hidden = p.dataset.tabPanel !== String(index);
          });
          
          const icons = Array.from(container.querySelectorAll("[data-tab-icon]"));
          icons.forEach((icon) => {
            icon.hidden = icon.dataset.tabIcon !== String(index);
          });

          if (dropdownList) {
            Array.from(dropdownList.querySelectorAll("a")).forEach(a => {
              if (a.dataset.dropdownIndex === String(index)) {
                a.classList.add("active");
              } else {
                a.classList.remove("active");
              }
            });
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            activateTab(Number(tab.dataset.tabIndex));
          });
        });

        if (dropdownList) {
          dropdownList.addEventListener("click", (e) => {
            const a = e.target.closest("[data-dropdown-index]");
            if (a) {
              activateTab(Number(a.dataset.dropdownIndex));
              document.activeElement?.blur();
            }
          });
        }

        let tabWidths = [];
        const updateOverflow = () => {
          if (!tabsContainer || !dropdown) return;
          
          if (tabWidths.length === 0) {
            tabs.forEach(t => {
              t.style.display = "block";
              tabWidths.push(t.offsetWidth);
            });
          }
          
          const availableWidth = tabsContainer.clientWidth;
          let currentWidth = 0;
          let hasOverflow = false;
          
          tabs.forEach((tab, index) => {
            const width = tabWidths[index];
            const dropdownItem = dropdownList?.querySelector(`[data-dropdown-index="${index}"]`)?.parentElement;
            if (!dropdownItem) return;

            if (hasOverflow || currentWidth + width > availableWidth) {
              hasOverflow = true;
              tab.style.display = "none";
              dropdownItem.style.display = "block";
            } else {
              currentWidth += width;
              tab.style.display = "block";
              dropdownItem.style.display = "none";
            }
          });
          
          if (hasOverflow) {
            dropdown.classList.remove("hidden");
          } else {
            dropdown.classList.add("hidden");
          }
        };

        if (tabsContainer) {
          const resizeObserver = new ResizeObserver(() => {
            requestAnimationFrame(updateOverflow);
          });
          resizeObserver.observe(tabsContainer);
        }
      });

      // Copy to clipboard for all code blocks (single and tabbed)
      document.querySelectorAll("[data-code-copy]").forEach((btn) => {
        // Skip if already wired up
        if (btn.dataset.copyBound) return;
        btn.dataset.copyBound = "true";

        btn.addEventListener("click", () => {
          const figure = btn.closest(".code-block-figure");
          if (!figure) return;

          const activePanel =
            figure.querySelector("[data-tab-panel]:not([hidden])") ||
            figure.querySelector("[data-code-panel]");
          if (!activePanel) return;

          const code = activePanel.textContent ?? "";
          navigator.clipboard.writeText(code).then(() => {
            const label = btn.querySelector(".copy-label");
            if (label) {
              label.textContent = "Copied!";
              setTimeout(() => {
                label.textContent = "Copy";
              }, 2000);
            } else {
              const originalHTML = btn.innerHTML;
              btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
              btn.setAttribute("aria-label", "Copied!");
              btn.setAttribute("title", "Copied!");
              setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.setAttribute("aria-label", "Copy code");
                btn.setAttribute("title", "Copy code");
              }, 2000);
            }
          });
        });
      });
    };

    initializeCodeBlocks();

    if (!document.documentElement.dataset.codeBlockPageLoadBound) {
      document.addEventListener("astro:page-load", initializeCodeBlocks);
      document.documentElement.dataset.codeBlockPageLoadBound = "true";
    }
  </script>

  <style is:global>
    /* Remove default prose spacing overrides on code blocks */
    .prose .code-block-figure {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }
  </style>

  {
    showTableOfContents && (
      <script is:inline>
        const POST_TOC_DRAWER_ID = "post-toc-drawer";
        const TOC_ACTIVE_CLASSES = ["border-primary", "text-base-content", "opacity-100", "font-medium"];

        const initializePostTableOfContents = () => {
          const existingCleanup = window.__postTocCleanup;
          if (typeof existingCleanup === "function") {
            existingCleanup();
          }

          const headings = Array.from(
            document.querySelectorAll("[data-toc-content] :is(h2[id], h3[id])"),
          );
          const links = Array.from(document.querySelectorAll("[data-toc-link]"));
          const drawer = document.getElementById(POST_TOC_DRAWER_ID);

          if (!headings.length || !links.length) {
            return;
          }

          let currentActiveId = "";

          const getHashId = () => window.location.hash.replace(/^#/, "");

          const getHeadingById = (id) => {
            return headings.find((heading) => heading.id === id);
          };

          const setActiveId = (id) => {
            currentActiveId = id;

            links.forEach((link) => {
              const isActive = link.dataset.tocId === id;

              if (isActive) {
                link.setAttribute("aria-current", "true");
              } else {
                link.removeAttribute("aria-current");
              }

              TOC_ACTIVE_CLASSES.forEach((className) => {
                link.classList.toggle(className, isActive);
              });
            });
          };

          const syncHash = (id) => {
            if (!id || getHashId() === id) {
              return;
            }

            const nextUrl = `${window.location.pathname}${window.location.search}#${id}`;
            window.history.replaceState(window.history.state, "", nextUrl);
          };

          const applyHashState = () => {
            const hashId = getHashId();

            if (!hashId) {
              return false;
            }

            if (!getHeadingById(hashId)) {
              return false;
            }

            setActiveId(hashId);
            return true;
          };

          const updateActiveId = () => {
            const topOffset = window.innerWidth >= 1280 ? 112 : 96;
            let activeHeading = headings[0];

            headings.forEach((heading) => {
              if (heading.getBoundingClientRect().top - topOffset <= 0) {
                activeHeading = heading;
              }
            });

            if (activeHeading && activeHeading.id) {
              if (activeHeading.id === currentActiveId) {
                return;
              }

              setActiveId(activeHeading.id);
              syncHash(activeHeading.id);
            }
          };

          const handleHashChange = () => {
            if (!applyHashState()) {
              updateActiveId();
            }
          };

          const observer = new IntersectionObserver(updateActiveId, {
            rootMargin: "-96px 0px -55% 0px",
            threshold: [0, 1],
          });

          headings.forEach((heading) => observer.observe(heading));
          window.addEventListener("scroll", updateActiveId, { passive: true });
          window.addEventListener("resize", updateActiveId);
          window.addEventListener("hashchange", handleHashChange);

          links.forEach((link) => {
            link.addEventListener("click", () => {
              if (drawer instanceof HTMLInputElement) {
                drawer.checked = false;
              }
            });
          });

          if (!applyHashState()) {
            updateActiveId();
          }

          window.__postTocCleanup = () => {
            observer.disconnect();
            window.removeEventListener("scroll", updateActiveId);
            window.removeEventListener("resize", updateActiveId);
            window.removeEventListener("hashchange", handleHashChange);
          };
        };

        initializePostTableOfContents();

        if (!document.documentElement.dataset.postTocPageLoadBound) {
          document.addEventListener("astro:page-load", initializePostTableOfContents);
          document.documentElement.dataset.postTocPageLoadBound = "true";
        }
      </script>
    )
  }
</BaseLayout>
