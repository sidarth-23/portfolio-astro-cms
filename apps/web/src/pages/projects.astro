---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, getProjectsPage, mediaToUrl } from "@/lib/cms/client";

const [projectsPage, projects] = await Promise.all([
  getProjectsPage(),
  getProjects(),
]);

const featuredProjects = projects.filter(
  (project) => project.section === "featured",
);
const newbieProjects = projects.filter(
  (project) => project.section === "newbie",
);

const toTags = (tags?: Array<{ value: string }> | null) => {
  return (tags || []).map((tag) => ({
    name: tag.value,
    slug: tag.value.toLowerCase().replace(/\s+/g, "-"),
  }));
};

const toBadges = (badges?: Array<{ value: string }> | null) => {
  return (badges || []).map((badge) => badge.value);
};
---

<BaseLayout
  title={projectsPage?.meta?.title || "Projects"}
  description={projectsPage?.meta?.description || "Projects"}
  image={mediaToUrl(projectsPage?.meta?.image)}
  canonicalUrl={projectsPage?.seoOverrides?.canonicalUrl}
  robotsIndex={projectsPage?.seoOverrides?.robotsIndex}
  robotsFollow={projectsPage?.seoOverrides?.robotsFollow}
  sideBarActiveItemID="projects"
>
  <div class="mb-8">
    <div class="text-3xl w-full font-bold mb-2">
      {projectsPage?.featuredTitle}
    </div>

    <div class="prose max-w-none">
      <RichTextRenderer data={projectsPage.featuredDescription} />
    </div>
  </div>

  {
    featuredProjects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          img={mediaToUrl(project.image)}
          descRich={project.description}
          badges={toBadges(project.badges)}
          tags={toTags(project.techTags)}
          tagBasePath={null}
          url={project.externalUrl}
          reverse={index % 2 === 1}
          wholeCardLink={true}
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <div class="my-8 mt-16">
    <div class="text-3xl w-full font-bold mb-2">
      {projectsPage?.newbieTitle}
    </div>

    <RichTextRenderer
      className="text-md"
      data={projectsPage.newbieDescription}
    />
  </div>

  {
    newbieProjects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          img={mediaToUrl(project.image)}
          descRich={project.description}
          badges={toBadges(project.badges)}
          tags={toTags(project.techTags)}
          tagBasePath={null}
          url={project.externalUrl}
          reverse={index % 2 === 1}
          wholeCardLink={true}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
