---
import { PhFunnel, PhInfo, PhMagnifyingGlass, PhWarningCircle, PhX } from "phosphor-icons-astro";
import { actions } from "astro:actions";
import HorizontalCard from "@/components/HorizontalCard.astro";
import BlogPagination from "@/components/BlogPagination.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import NotFoundState from "@/components/NotFoundState.astro";
import { cmsClient } from "@/lib/cms";

export const prerender = false;

const view = Astro.url.searchParams.get("view") === "series" ? "series" : "posts";
const pageParam = Astro.url.searchParams.get("page");
const parsedPage = pageParam ? Number.parseInt(pageParam, 10) : 1;
const currentPage = Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const searchQuery = Astro.url.searchParams.get("q") || undefined;
const categoryFilter = Astro.url.searchParams.get("category") || undefined;
const seriesFilter = Astro.url.searchParams.get("series") || undefined;

const { data, error } = await Astro.callAction(actions.cms.search, {
  view: view === "series" ? "series" : "posts",
  page: currentPage,
  search: searchQuery,
  category: categoryFilter,
  series: seriesFilter,
});

if (error) {
  Astro.response.status = 500;
}

const [paginatedPosts, allCategories, allSeries, blogPage] = data ?? [null, [], [], { meta: null }];

const { meta } = blogPage;
const pageTitle = meta?.title ?? "Blog";
const pageDescription = meta?.description ?? "Articles, notes, and ideas.";

const buildBlogUrl = (overrides: {
  q?: string | null;
  category?: string | null;
  series?: string | null;
  view?: string | null;
  page?: number | null;
}): string => {
  const params = new URLSearchParams();
  const finalQuery = overrides.q === null ? undefined : (overrides.q ?? searchQuery);
  const finalCategory =
    overrides.category === null ? undefined : (overrides.category ?? categoryFilter);
  const finalSeries = overrides.series === null ? undefined : (overrides.series ?? seriesFilter);
  const finalView = overrides.view === null ? undefined : (overrides.view ?? view);
  const finalPage = overrides.page === null ? undefined : (overrides.page ?? currentPage);

  if (finalQuery) params.set("q", finalQuery);
  if (finalCategory) params.set("category", finalCategory);
  if (finalSeries) params.set("series", finalSeries);
  if (finalView && finalView !== "posts") params.set("view", finalView);
  if (finalPage && finalPage > 1) params.set("page", String(finalPage));

  return `/blog/search${params.toString() ? `?${params.toString()}` : ""}`;
};

const buildPageUrl = (page: number): string => buildBlogUrl({ page: page === 1 ? null : page });
const hasActiveFilters = Boolean(searchQuery || categoryFilter || seriesFilter);
const activeCategory = categoryFilter
  ? allCategories.find((category) => category.slug === categoryFilter)
  : undefined;
const activeSeries = seriesFilter
  ? allSeries.find((series) => series.slug === seriesFilter)
  : undefined;
---

{
  error ? (
    <ErrorLayout title="Something went wrong" description="We ran into an unexpected error.">
      <NotFoundState
        title="Something went wrong"
        description="We ran into an unexpected error. Please try again later."
        ctaLabel="Back to home"
        ctaHref="/"
        icon={PhWarningCircle}
      />
    </ErrorLayout>
  ) : data ? (
    <BaseLayout
      title="Blog"
      seoTitle={pageTitle}
      description={pageDescription}
      image={cmsClient.mediaToUrl(meta?.image)}
    >
      <div class="mb-5 flex flex-col md:flex-row items-center justify-between gap-4">
        <h1 class="text-3xl font-bold">Blog</h1>

        <div role="tablist" class="tabs tabs-boxed">
          <a role="tab" class={`tab ${view === "posts" ? "tab-active" : ""}`} href="/blog">
            Posts
          </a>
          <a role="tab" class={`tab ${view === "series" ? "tab-active" : ""}`} href="/blog/series">
            Series
          </a>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-4 mb-6 relative z-30">
        <form method="GET" action="/blog/search" class="flex-1 join">
          <input
            type="search"
            name="q"
            placeholder={view === "series" ? "Search series..." : "Search posts..."}
            value={searchQuery || ""}
            class="input input-bordered join-item flex-1"
          />
          {categoryFilter && <input type="hidden" name="category" value={categoryFilter} />}
          {seriesFilter && <input type="hidden" name="series" value={seriesFilter} />}
          {view !== "posts" && <input type="hidden" name="view" value={view} />}
          <button type="submit" class="btn btn-primary join-item">
            <PhMagnifyingGlass class="h-5 w-5" />
          </button>
        </form>

        <div class="dropdown dropdown-end relative z-40">
          <div tabindex="0" role="button" class="btn btn-outline gap-2">
            <PhFunnel class="h-5 w-5" />
            Filter
            {hasActiveFilters && (
              <div class="badge badge-sm badge-circle">
                {(categoryFilter ? 1 : 0) + (seriesFilter ? 1 : 0)}
              </div>
            )}
          </div>
          <div
            tabindex="0"
            class="dropdown-content z-50 w-72 rounded-box bg-base-100 p-4 shadow pointer-events-auto"
          >
            <div class="flex justify-between items-center mb-2">
              <h3 class="text-sm font-semibold">Categories</h3>
              {categoryFilter && (
                <a href={buildBlogUrl({ category: null, page: 1 })} class="link link-error text-xs">
                  Clear
                </a>
              )}
            </div>
            <div class="flex flex-wrap gap-2 mb-4">
              {allCategories.map((category) => (
                <a
                  href={buildBlogUrl({
                    category: category.slug === categoryFilter ? null : category.slug,
                    page: 1,
                  })}
                  class={`badge badge-soft badge-sm no-underline ${category.slug === categoryFilter ? "badge-accent" : "badge-info"}`}
                >
                  {category.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      {hasActiveFilters && (
        <div class="flex flex-wrap items-center gap-2 mb-6">
          <span class="text-sm opacity-70">Active filters:</span>
          {searchQuery && (
            <a
              href={buildBlogUrl({ q: null, page: 1 })}
              class="badge gap-2 hover:badge-error group"
            >
              "{searchQuery}"
              <PhX class="h-4 w-4 group-hover:block" />
            </a>
          )}
          {activeCategory && (
            <a
              href={buildBlogUrl({ category: null, page: 1 })}
              class="badge badge-soft badge-accent badge-sm gap-2 hover:badge-error"
            >
              {activeCategory.name}
              <PhX class="h-4 w-4" />
            </a>
          )}
          {activeSeries && (
            <a
              href={buildBlogUrl({ series: null, page: 1 })}
              class="badge badge-info gap-2 hover:badge-error"
            >
              {activeSeries.name}
              <PhX class="h-4 w-4" />
            </a>
          )}
          <a
            href={buildBlogUrl({ q: null, category: null, series: null, page: 1 })}
            class="btn btn-xs btn-ghost"
          >
            Clear all
          </a>
        </div>
      )}

      {view === "series" ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          {allSeries.filter(
            (series) =>
              !searchQuery || series.name.toLowerCase().includes(searchQuery.toLowerCase()),
          ).length > 0 ? (
            allSeries
              .filter(
                (series) =>
                  !searchQuery || series.name.toLowerCase().includes(searchQuery.toLowerCase()),
              )
              .map((series) => (
                <a
                  href={`/blog/series/${series.slug}`}
                  class="card card-compact bg-base-200 transition-colors duration-300 ease-in-out hover:bg-base-300 group no-underline"
                >
                  <div class="card-body">
                    <h3 class="card-title text-lg">
                      {series.name}
                      <span class="opacity-0 group-hover:opacity-100 transition-opacity translate-x-1 group-hover:translate-x-2">
                        →
                      </span>
                    </h3>
                    {series.description && <p class="text-base-content/70">{series.description}</p>}
                    <div class="card-actions justify-end mt-2">
                      <div class="badge badge-outline">{series.postCount} posts</div>
                    </div>
                  </div>
                </a>
              ))
          ) : (
            <div class="col-span-2 alert">No series found.</div>
          )}
        </div>
      ) : paginatedPosts ? (
        <>
          <div class="mb-4 text-sm text-base-content/70 flex justify-between items-center">
            <span>
              {paginatedPosts.totalDocs > 0
                ? `Showing ${paginatedPosts.docs.length} of ${paginatedPosts.totalDocs} posts`
                : "No posts found"}
            </span>
          </div>

          {paginatedPosts.docs.length === 0 ? (
            <div class="alert bg-base-200">
              <PhInfo class="shrink-0 h-6 w-6" />
              <div>
                <p class="font-bold">No posts found matching your filters.</p>
                <p>Try clearing some filters or searching for something else.</p>
              </div>
            </div>
          ) : (
            <ul>
              {paginatedPosts.docs.map((post, index) => (
                <>
                  <HorizontalCard
                    title={post.title}
                    img={cmsClient.mediaSizeUrl(post.coverImage, "card")}
                    desc={post.description}
                    url={`/blog/${post.slug}`}
                    target="_self"
                    category={cmsClient.categoryFromPost(post)}
                    series={cmsClient.seriesFromPost(post)}
                    tags={cmsClient.tagsFromPost(post)}
                  />
                  {index < paginatedPosts.docs.length - 1 && (
                    <div class="divider my-0 opacity-50" />
                  )}
                </>
              ))}
            </ul>
          )}

          {paginatedPosts.totalPages > 1 && (
            <div class="flex justify-center my-10">
              <BlogPagination
                currentPage={currentPage}
                totalPages={paginatedPosts.totalPages}
                buildPageUrl={buildPageUrl}
              />
            </div>
          )}
        </>
      ) : (
        <div class="alert bg-base-200">
          <PhMagnifyingGlass class="shrink-0 h-6 w-6" />
          <div>
            <p class="font-bold">Search the blog</p>
            <p>Enter a title or description to find published posts.</p>
          </div>
        </div>
      )}
    </BaseLayout>
  ) : null
}
