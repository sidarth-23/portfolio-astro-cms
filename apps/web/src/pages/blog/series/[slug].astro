---
import { PhCaretLeft } from "phosphor-icons-astro";
import type { Post, Series } from "@sidshub/cms-core/payload-types";

import HorizontalCard from "@/components/HorizontalCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cmsClient } from "@/lib/cms";

type SeriesPageProps = {
  series: Series;
  posts: Post[];
};

export async function getStaticPaths() {
  if (String(import.meta.env.ASTRO_MOCK_CMS ?? process.env.ASTRO_MOCK_CMS ?? "") === "true") {
    return [];
  }

  try {
    const entries = await cmsClient.getSeriesStaticPathsData();
    return entries.map((entry) => {
      return {
        params: { slug: entry.slug },
        props: {
          series: entry.series,
          posts: entry.posts,
        },
      };
    });
  } catch {
    return [];
  }
}

const { series, posts } = Astro.props as SeriesPageProps;
const { meta: seriesPageMeta, backToSeriesLabel = "Back to Series" } =
  await cmsClient.getSeriesPage();

if (!seriesPageMeta.title || !seriesPageMeta.description) {
  throw new Error("Series page requires SEO `meta.title` and `meta.description`.");
}

const seriesSeoTitle = series.meta?.title || seriesPageMeta.title;
const seriesSeoDescription = series.meta?.description || seriesPageMeta.description;
---

<BaseLayout
  title={`${series.name} - Series`}
  seoTitle={seriesSeoTitle}
  description={seriesSeoDescription}
  image={cmsClient.mediaToUrl(series.meta?.image) ?? cmsClient.mediaToUrl(seriesPageMeta?.image)}
>
  <div class="mb-6">
    <a
      href="/blog?view=series"
      class="btn btn-ghost btn-sm pl-0 hover:bg-transparent hover:text-secondary transition-colors"
    >
      <PhCaretLeft class="h-5 w-5 inline-block mr-1" />
      {backToSeriesLabel}
    </a>
  </div>

  <div class="mb-6 w-full">
    <div class="flex flex-col gap-4">
      <h1 class="text-4xl font-bold">{series.name}</h1>
      {
        series.description && (
          <p class="text-xl text-base-content/80 leading-relaxed">{series.description}</p>
        )
      }
      <div>
        <span class="badge badge-secondary badge-lg">{posts.length} Posts</span>
      </div>
    </div>
  </div>

  <div class="divider mb-8"></div>

  {
    posts.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-6 min-w-full rounded-r-lg">
        <p class="font-bold text-lg">No posts yet!</p>
        <p>This series doesn't have any posts yet. Check back later!</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-6">
        {posts.map((post, index) => (
          <li>
            <HorizontalCard
              title={`Part ${index + 1}: ${post.title}`}
              img={cmsClient.mediaSizeUrl(post.coverImage, "card")}
              desc={post.description}
              url={`/blog/${post.slug}`}
              target="_self"
              category={cmsClient.categoryFromPost(post)}
              series={cmsClient.seriesFromPost(post)}
              tags={cmsClient.tagsFromPost(post)}
            />
            {index < posts.length - 1 && <div class="divider my-0 opacity-50" />}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
