---
import type { GetStaticPaths } from "astro";
import type { CmsPost, CmsSeries } from "@/lib/cms/models";

import HorizontalCard from "@/components/HorizontalCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryFromPost,
  getPostsBySeries,
  getSeriesSlugs,
  mediaToUrl,
  seriesFromPost,
  tagsFromPost,
} from "@/lib/cms/client";

type SeriesPageProps = {
  series: CmsSeries;
  posts: CmsPost[];
};

export const getStaticPaths = (async () => {
  const seriesSlugs = await getSeriesSlugs();

  const paths = await Promise.all(
    seriesSlugs.map(async (slug) => {
      const posts = await getPostsBySeries(slug);

      if (posts.length === 0) {
        return null;
      }

      const series = posts[0].series;
      if (!series) {
        return null;
      }

      return {
        params: { slug },
        props: {
          series,
          posts,
        },
      };
    }),
  );

  return paths.filter(
    (path): path is NonNullable<typeof path> => path !== null,
  );
}) satisfies GetStaticPaths;

const { series, posts } = Astro.props as SeriesPageProps;
---

<BaseLayout title={`${series.name} - Series`} sideBarActiveItemID="blog">
  <div class="mb-6">
    <a
      href="/blog?view=series"
      class="btn btn-ghost btn-sm pl-0 hover:bg-transparent hover:text-secondary transition-colors"
    >
      <svg
        class="h-5 w-5 fill-current inline-block mr-1"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      >
        <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
        ></path>
      </svg>
      Back to Series
    </a>
  </div>

  <div class="mb-6 w-full">
    <div class="flex flex-col gap-4">
      <h1 class="text-4xl font-bold">{series.name}</h1>
      {
        series.description && (
          <p class="text-xl text-base-content/80 leading-relaxed">
            {series.description}
          </p>
        )
      }
      <div>
        <span class="badge badge-secondary badge-lg">{posts.length} Posts</span>
      </div>
    </div>
  </div>

  <div class="divider mb-8"></div>

  {
    posts.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-6 min-w-full rounded-r-lg">
        <p class="font-bold text-lg">No posts yet!</p>
        <p>This series doesn't have any posts yet. Check back later!</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-6">
        {posts.map((post, index) => (
          <li>
            <HorizontalCard
              title={`Part ${post.seriesOrder ?? index + 1}: ${post.title}`}
              img={mediaToUrl(post.coverImage)}
              desc={post.excerpt}
              url={`/blog/${post.slug}`}
              target="_self"
              category={categoryFromPost(post)}
              series={seriesFromPost(post)}
              tags={tagsFromPost(post)}
            />
            {index < posts.length - 1 && (
              <div class="divider my-0 opacity-50" />
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
