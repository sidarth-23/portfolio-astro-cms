---
import { PhCaretLeft } from "phosphor-icons-astro";
import type { GetStaticPaths } from "astro";
import type { Post, Series } from "@sidshub/cms-config/payload-types";

import HorizontalCard from "@/components/HorizontalCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryFromPost,
  getSeriesBySlug,
  getPostsBySeries,
  getSeriesPage,
  getSeriesSlugs,
  mediaToUrl,
  seriesFromPost,
  tagsFromPost,
} from "@/lib/cms/client";

type SeriesPageProps = {
  series: Series;
  posts: Post[];
};

export const getStaticPaths = (async () => {
  const seriesSlugs = await getSeriesSlugs();

  const paths = await Promise.all(
    seriesSlugs.map(async (slug) => {
      const posts = await getPostsBySeries(slug);
      const series = await getSeriesBySlug(slug);

      if (posts.length === 0 || !series) {
        return null;
      }

      return {
        params: { slug },
        props: {
          series,
          posts,
        },
      };
    }),
  );

  return paths.filter(
    (path): path is NonNullable<typeof path> => path !== null,
  );
}) satisfies GetStaticPaths;

const { series, posts } = Astro.props as SeriesPageProps;
const seriesPage = await getSeriesPage();

const seriesPageSeoTitle = seriesPage.meta?.title?.trim();
const seriesPageSeoDescription = seriesPage.meta?.description?.trim();

if (!seriesPageSeoTitle || !seriesPageSeoDescription) {
  throw new Error("Series page requires SEO `meta.title` and `meta.description`.");
}

const seriesSeoTitle = series.meta?.title?.trim() || seriesPageSeoTitle;
const seriesSeoDescription =
  series.meta?.description?.trim() || seriesPageSeoDescription;
const backToSeriesLabel = seriesPage.backToSeriesLabel?.trim() || "Back to Series";
---

<BaseLayout
  title={`${series.name} - Series`}
  seoTitle={seriesSeoTitle}
  description={seriesSeoDescription}
  image={mediaToUrl(series.meta?.image) ?? mediaToUrl(seriesPage.meta?.image)}
  sideBarActiveItemID="blog"
>
  <div class="mb-6">
    <a
      href="/blog?view=series"
      class="btn btn-ghost btn-sm pl-0 hover:bg-transparent hover:text-secondary transition-colors"
    >
      <PhCaretLeft class="h-5 w-5 inline-block mr-1" />
      {backToSeriesLabel}
    </a>
  </div>

  <div class="mb-6 w-full">
    <div class="flex flex-col gap-4">
      <h1 class="text-4xl font-bold">{series.name}</h1>
      {
        series.description && (
          <p class="text-xl text-base-content/80 leading-relaxed">
            {series.description}
          </p>
        )
      }
      <div>
        <span class="badge badge-secondary badge-lg">{posts.length} Posts</span>
      </div>
    </div>
  </div>

  <div class="divider mb-8"></div>

  {
    posts.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-6 min-w-full rounded-r-lg">
        <p class="font-bold text-lg">No posts yet!</p>
        <p>This series doesn't have any posts yet. Check back later!</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-6">
        {posts.map((post, index) => (
          <li>
            <HorizontalCard
              title={`Part ${index + 1}: ${post.title}`}
              img={mediaToUrl(post.coverImage)}
              desc={post.excerpt}
              url={`/blog/${post.slug}`}
              target="_self"
              category={categoryFromPost(post)}
              series={seriesFromPost(post)}
              tags={tagsFromPost(post)}
            />
            {index < posts.length - 1 && (
              <div class="divider my-0 opacity-50" />
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
