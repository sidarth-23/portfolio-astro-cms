---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import SeriesNav from "@/components/SeriesNav.astro";
import PostLayout from "@/layouts/PostLayout.astro";
import { ASTRO_CMS_API_URL, ASTRO_CMS_READ_TOKEN } from "astro:env/server";
import { extractTableOfContents } from "@sidshub/lexical/web";
import { createCmsRestClient } from "@sidshub/cms-config/rest-client";
import type { Post } from "@sidshub/cms-config/payload-types";

const cmsClient = createCmsRestClient({ apiUrl: ASTRO_CMS_API_URL, token: ASTRO_CMS_READ_TOKEN });

type SeriesNavProps = {
  seriesName: string;
  seriesSlug: string;
  currentPart: number;
  totalParts: number;
  prevPost?: {
    slug: string;
    title: string;
  };
  nextPost?: {
    slug: string;
    title: string;
  };
};

export async function getStaticPaths() {
  const staticPathsCmsClient = createCmsRestClient({
    apiUrl: ASTRO_CMS_API_URL,
    token: ASTRO_CMS_READ_TOKEN,
  });

  const posts = await staticPathsCmsClient.getAllPublishedPosts();
  const seriesSlugs = Array.from(
    new Set(
      posts
        .map((post) => staticPathsCmsClient.seriesFromPost(post)?.slug)
        .filter((slug): slug is string => Boolean(slug)),
    ),
  );

  // Build a map of series slug to posts ordered in CMS.
  const seriesMap = new Map<string, Post[]>();
  const orderedSeriesPosts = await Promise.all(
    seriesSlugs.map(async (slug) => ({
      slug,
      posts: await staticPathsCmsClient.getPostsBySeries(slug),
    })),
  );
  orderedSeriesPosts.forEach((item) => {
    seriesMap.set(item.slug, item.posts);
  });

  return posts.map((post) => {
    let seriesNav: SeriesNavProps | undefined;

    const series = staticPathsCmsClient.seriesFromPost(post);
    if (series?.slug) {
      const seriesPosts = seriesMap.get(series.slug) || [];
      const currentIndex = seriesPosts.findIndex((p) => p.slug === post.slug);

      if (currentIndex !== -1) {
        const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : undefined;
        const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : undefined;

        seriesNav = {
          seriesName: series.name,
          seriesSlug: series.slug,
          currentPart: currentIndex + 1,
          totalParts: seriesPosts.length,
          prevPost: prevPost ? { slug: prevPost.slug, title: prevPost.title } : undefined,
          nextPost: nextPost ? { slug: nextPost.slug, title: nextPost.title } : undefined,
        };
      }
    }

    return {
      params: { slug: post.slug },
      props: { post, seriesNav },
    };
  });
}

interface Props {
  post: Post;
  seriesNav?: SeriesNavProps;
}

const { post, seriesNav } = Astro.props;
const category = cmsClient.categoryFromPost(post);
const series = cmsClient.seriesFromPost(post);
const tags = cmsClient.tagsFromPost(post);
const authors = cmsClient.authorsFromPost(post);
const toc = extractTableOfContents(post.content);
const pubDate = post.publishedAt || post.createdAt || new Date().toISOString();
const postSeoTitle = post.meta?.title?.trim();
const postSeoDescription = post.meta?.description?.trim();

if (!postSeoTitle || !postSeoDescription) {
  throw new Error(`Post "${post.slug}" requires SEO \`meta.title\` and \`meta.description\`.`);
}
---

<PostLayout
  title={post.title}
  seoTitle={postSeoTitle}
  description={postSeoDescription}
  pubDate={pubDate}
  updatedDate={post.updatedAt}
  heroImage={cmsClient.mediaToUrl(post.coverImage)}
  tags={tags}
  category={category}
  series={series}
  authors={authors}
  toc={toc}
>
  {seriesNav && (
    <SeriesNav
      position="top"
      seriesName={seriesNav.seriesName}
      seriesSlug={seriesNav.seriesSlug}
      currentPart={seriesNav.currentPart}
      totalParts={seriesNav.totalParts}
      prevPost={seriesNav.prevPost}
      nextPost={seriesNav.nextPost}
    />
  )}

  <RichTextRenderer data={post.content} />

  {seriesNav && (
    <SeriesNav
      position="bottom"
      seriesName={seriesNav.seriesName}
      seriesSlug={seriesNav.seriesSlug}
      currentPart={seriesNav.currentPart}
      totalParts={seriesNav.totalParts}
      prevPost={seriesNav.prevPost}
      nextPost={seriesNav.nextPost}
    />
  )}

  {
    authors.length > 0 && (
      <section class="mt-16 sm:mt-24 pt-10 border-t border-base-200/50">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/50 mb-8">
          {authors.length > 1 ? "Authors" : "Author"}
        </h2>
        <div class="flex flex-col gap-10">
          {authors.map((author) => {
            const avatarUrl = cmsClient.mediaToUrl(author.avatar);

            return (
              <article class="flex flex-col sm:flex-row gap-6 items-start bg-base-200/30 p-6 sm:p-8 rounded-2xl">
                {avatarUrl ? (
                  <img
                    src={avatarUrl}
                    alt={author.name || "Author avatar"}
                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover shrink-0 ring-1 ring-base-content/10"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full shrink-0 bg-base-300/50 flex items-center justify-center text-base-content/40 ring-1 ring-base-content/10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </div>
                )}
                <div class="flex-1">
                  <h3 class="text-lg font-semibold">{author.name || "Unknown Author"}</h3>
                  {author.bio && (
                    <div class="mt-3 text-sm sm:text-base leading-relaxed text-base-content/70 prose prose-sm max-w-none prose-p:last:mb-0">
                      <RichTextRenderer data={author.bio} />
                    </div>
                  )}
                  {((author as any).linkedInUrl || (author as any).githubUrl) && (
                    <div class="mt-5 flex gap-4 items-center">
                      {(author as any).githubUrl && (
                        <a href={(author as any).githubUrl} target="_blank" rel="noopener noreferrer" class="text-base-content/50 hover:text-base-content transition-colors" aria-label="GitHub">
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                        </a>
                      )}
                      {(author as any).linkedInUrl && (
                        <a href={(author as any).linkedInUrl} target="_blank" rel="noopener noreferrer" class="text-base-content/50 hover:text-base-content transition-colors" aria-label="LinkedIn">
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }
</PostLayout>
