---
import type { GetStaticPaths } from "astro";
import type { CmsPost } from "@sidshub/cms-types";

import HorizontalCard from "@/components/HorizontalCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryFromPost,
  getPaginatedPublishedPosts,
  getTagSlugs,
  mediaToUrl,
  tagsFromPost,
} from "@/lib/cms/client";

const PAGE_SIZE = 10;

type TagPageProps = {
  page: {
    data: CmsPost[];
    url: {
      prev: string | null;
      next: string | null;
    };
  };
};

const buildTagPageUrl = (tag: string, pageNumber: number): string => {
  return pageNumber <= 1 ? `/blog/tag/${tag}` : `/blog/tag/${tag}/${pageNumber}`;
};

export const getStaticPaths = (async () => {
  const allTags = await getTagSlugs();
  const paths: Awaited<ReturnType<GetStaticPaths>> = [];

  for (const tag of allTags) {
    const firstPage = await getPaginatedPublishedPosts({
      page: 1,
      pageSize: PAGE_SIZE,
      tagSlug: tag,
    });

    if (firstPage.totalDocs === 0) {
      continue;
    }

    for (let pageNumber = 1; pageNumber <= firstPage.totalPages; pageNumber += 1) {
      const currentPage =
        pageNumber === 1
          ? firstPage
          : await getPaginatedPublishedPosts({
              page: pageNumber,
              pageSize: PAGE_SIZE,
              tagSlug: tag,
            });

      paths.push({
        params: {
          tag,
          ...(pageNumber === 1 ? {} : { page: String(pageNumber) }),
        },
        props: {
          page: {
            data: currentPage.docs,
            url: {
              prev: currentPage.prevPage ? buildTagPageUrl(tag, currentPage.prevPage) : null,
              next: currentPage.nextPage ? buildTagPageUrl(tag, currentPage.nextPage) : null,
            },
          },
        },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { page } = Astro.props as TagPageProps;
const { tag } = Astro.params;
---

<BaseLayout title={`Blog - ${tag}`} sideBarActiveItemID="blog">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Blog - {tag}</div>
  </div>
  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">Sorry!</p>
        <p>There are no blog posts to show at the moment. Check back later!</p>
      </div>
    ) : (
      <ul>
        {page.data.map((post) => (
          <>
            <HorizontalCard
              title={post.title}
              img={mediaToUrl(post.coverImage)}
              desc={post.excerpt}
              url={`/blog/${post.slug}`}
              target="_self"
              category={categoryFromPost(post)}
              tags={tagsFromPost(post)}
            />
            <div class="divider my-0" />
          </>
        ))}
      </ul>
    )
  }

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>
          Recent posts
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          Older Posts
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
