---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import TimeLineElement from "@/components/cv/TimeLine.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ASTRO_CMS_API_URL, ASTRO_CMS_READ_TOKEN } from "astro:env/server";
import { createCmsRestClient } from "@sidshub/cms-config/rest-client";
import { PhLink } from "phosphor-icons-astro";

const cmsClient = createCmsRestClient({ apiUrl: ASTRO_CMS_API_URL, token: ASTRO_CMS_READ_TOKEN });
const cvPage = await cmsClient.getCvPage();
const cvSeoTitle = cvPage.meta?.title?.trim();
const cvSeoDescription = cvPage.meta?.description?.trim();

if (!cvSeoTitle || !cvSeoDescription) {
  throw new Error("CV page requires SEO `meta.title` and `meta.description`.");
}

const formatMonth = (dateStr: string) => {
  if (!dateStr) return null;
  const date = new Date(dateStr);
  if (Number.isNaN(date.getTime())) return dateStr;
  return new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(date);
};

const getSubtitle = (item: any) => {
  if (item.itemType === "organizationRole") {
    const start = formatMonth(item.startMonth);
    const end = formatMonth(item.endMonth) || "Present";
    const generated = [
      [start, end].filter(Boolean).join(" - "),
      item.organization,
      item.location,
    ]
      .filter(Boolean)
      .join(" | ");
      
    // If a manual subtitle is provided in the CMS, append the generated string to it, or just return it if generated is empty
    if (item.subtitle) {
      return generated ? `${item.subtitle} • ${generated}` : item.subtitle;
    }
    return generated;
  }
  return item.subtitle || "";
};
---

<BaseLayout
  title="Resume"
  seoTitle={cvSeoTitle}
  description={cvSeoDescription}
  image={cmsClient.mediaToUrl(cvPage.meta?.image)}
>
  {
    cvPage.sections.map((section) => (
      <section class="mb-10">
        <div class="mb-5">
          <h2 class="text-3xl w-full font-bold">{section.title}</h2>
        </div>

        {section.type === "description" && section.description && (
          <div class="prose max-w-none text-justify">
            <RichTextRenderer data={section.description} />
          </div>
        )}

        {section.type === "items" && section.itemsVariant === "timeline" && (
          <div class="time-line-container grid gap-4">
            {(section.items || []).map((item) => (
              <TimeLineElement
                title={item.title}
                subtitle={getSubtitle(item)}
                url={item.url}
              >
                {item.content && (
                  <div class="prose max-w-none">
                    <RichTextRenderer data={item.content} />
                  </div>
                )}
              </TimeLineElement>
            ))}
          </div>
        )}

        {section.type === "items" && section.itemsVariant === "list" && (
          <ul class="list-disc mx-6 grid gap-2">
            {(section.items || []).map((item) => (
              <li>
                <div class="font-medium flex items-center gap-2">
                  {item.title}
                  {item.url && (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="opacity-50 hover:opacity-100 transition-opacity">
                      <PhLink size={18} />
                    </a>
                  )}
                </div>
                {getSubtitle(item) && (
                  <div class="text-sm opacity-80">{getSubtitle(item)}</div>
                )}
                {item.content && (
                  <div class="prose max-w-none">
                    <RichTextRenderer data={item.content} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        )}

        {section.type === "items" && section.itemsVariant === "columns" && (
          <ul class="list-disc mx-6 grid gap-4 md:columns-3 columns-1">
            {(section.items || []).map((item) => (
              <li>
                <div class="font-medium flex items-center gap-2">
                  {item.title}
                  {item.url && (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="opacity-50 hover:opacity-100 transition-opacity">
                      <PhLink size={18} />
                    </a>
                  )}
                </div>
                {getSubtitle(item) && (
                  <div class="text-sm opacity-80">{getSubtitle(item)}</div>
                )}
                {item.content && (
                  <div class="prose max-w-none">
                    <RichTextRenderer data={item.content} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        )}

        {section.type === "badges" && (
          <div class="flex flex-wrap gap-2">
            {(section.badges || []).map((badge) => (
              <span class="badge badge-outline">{badge.value}</span>
            ))}
          </div>
        )}
      </section>
    ))
  }
</BaseLayout>

<style>
  .time-line-container > div:last-child .education__time > .education__line {
    display: none;
  }

  a {
    transition: opacity 0.3s ease-in-out;
  }

  a:hover {
    opacity: 0.8;
  }

  a:hover:after {
    opacity: 1;
  }
</style>
