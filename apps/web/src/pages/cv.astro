---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import TimeLineElement from "@/components/cv/TimeLine.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCvPage, mediaToUrl } from "@/lib/cms/client";

const cvPage = await getCvPage();
---

<BaseLayout
  title={cvPage?.meta?.title || "Resume"}
  description={cvPage?.meta?.description || "Resume"}
  image={mediaToUrl(cvPage?.meta?.image)}
  canonicalUrl={cvPage?.seoOverrides?.canonicalUrl}
  robotsIndex={cvPage?.seoOverrides?.robotsIndex}
  robotsFollow={cvPage?.seoOverrides?.robotsFollow}
  sideBarActiveItemID="cv"
>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    {
      cvPage?.profile && (
        <div class="prose max-w-none">
          <RichTextRenderer data={cvPage.profile} />
        </div>
      )
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    {
      (cvPage?.education || []).map((item) => (
        <TimeLineElement title={item.key} subtitle={item.summary || ""}>
          {item.content && (
            <div class="prose prose-sm max-w-none">
              <RichTextRenderer data={item.content} />
            </div>
          )}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    {
      (cvPage?.experience || []).map((item) => (
        <TimeLineElement title={item.key} subtitle={item.summary || ""}>
          {item.content && (
            <div class="prose prose-sm max-w-none">
              <RichTextRenderer data={item.content} />
            </div>
          )}
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications (with link)</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {
      (cvPage?.certifications || []).map((item) => (
        <li>
          <div class="font-medium">{item.key}</div>
          {item.summary && <div class="text-sm opacity-80">{item.summary}</div>}
          {item.content && (
            <div class="prose prose-sm max-w-none">
              <RichTextRenderer data={item.content} />
            </div>
          )}
        </li>
      ))
    }
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-3 columns-1 mx-6 grid gap-4">
    {(cvPage?.skills || []).map((item) => (
      <li>
        <div class="font-medium">{item.key}</div>
        {item.summary && <div class="text-sm opacity-80">{item.summary}</div>}
        {item.content && (
          <div class="prose prose-sm max-w-none">
            <RichTextRenderer data={item.content} />
          </div>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .time-line-container > div:last-child .education__time > .education__line {
    display: none;
  }
  a {
    transition: opacity 0.3s ease-in-out;
  }

  a:hover {
    opacity: 0.8;
  }

  a:hover:after {
    opacity: 1;
  }
</style>
