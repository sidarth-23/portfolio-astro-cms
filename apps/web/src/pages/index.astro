---
import HorizontalCard from "@/components/HorizontalCard.astro";
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import { ASTRO_CMS_API_URL, ASTRO_CMS_READ_TOKEN } from "astro:env/server";
import { createCmsRestClient } from "@sidshub/cms-config/rest-client";
import type { Post, Project, Media } from "@sidshub/cms-config/payload-types";
import BaseLayout from "@/layouts/BaseLayout.astro";

const cmsClient = createCmsRestClient({ apiUrl: ASTRO_CMS_API_URL, token: ASTRO_CMS_READ_TOKEN });

const homePage = await cmsClient.getHomePage();
const { meta, featured } = homePage;

if (!meta.title || !meta.description) {
  throw new Error("Home page requires SEO `meta.title` and `meta.description`.");
}

type FeaturedRelation =
  | { relationTo: "posts"; value: Post | number }
  | { relationTo: "projects"; value: Project | number };

const featuredItems: FeaturedRelation[] = (featured?.items ?? []).filter(
  (item): item is FeaturedRelation => typeof item === "object" && item !== null && typeof (item as FeaturedRelation).value === "object",
) as FeaturedRelation[];
---

<BaseLayout
  title="Home"
  seoTitle={meta.title}
  description={meta.description}
  image={cmsClient.mediaToUrl(meta?.image)}
>
  <div>
    <div class="text-xl py-1">{homePage?.greeting}</div>
    <div class="text-5xl font-bold">{homePage?.name}</div>
    <div class="text-3xl py-3 font-bold">
      {homePage?.role}
    </div>

    <div class="prose prose-lg py-2 max-w-none">
      <RichTextRenderer data={homePage.about} mediaBaseUrl={ASTRO_CMS_API_URL} />
    </div>
  </div>

  {
    featuredItems.length > 0 && (
      <section class="mt-14">
        {featured?.title && (
          <h2 class="text-2xl font-bold mb-6">{featured.title}</h2>
        )}
        <div class="flex flex-col gap-4">
          {featuredItems.map((relation) => {
            if (relation.relationTo === "posts" && typeof relation.value === "object") {
              const post = relation.value as Post;
              const category = cmsClient.categoryFromPost(post);
              const series = cmsClient.seriesFromPost(post);
              const tags = cmsClient.tagsFromPost(post);
              return (
                <HorizontalCard
                  title={post.title}
                  img={cmsClient.mediaToUrl(post.coverImage as Media | number | null | undefined)}
                  desc={post.excerpt}
                  url={`/blog/${post.slug}`}
                  target="_self"
                  category={category}
                  series={series}
                  tags={tags}
                />
              );
            }

            if (relation.relationTo === "projects" && typeof relation.value === "object") {
              const project = relation.value as Project;
              const badges = cmsClient.badgesFromProject(project);
              const tags = cmsClient.tagsFromProject(project);
              return (
                <HorizontalCard
                  title={project.title}
                  img={cmsClient.mediaToUrl(project.image as Media | number | null | undefined)}
                  descRich={project.description}
                  url={project.externalUrl}
                  target="_blank"
                  badges={badges}
                  tags={tags}
                  githubUrl={project.githubUrl ?? undefined}
                />
              );
            }

            return null;
          })}
        </div>
      </section>
    )
  }
</BaseLayout>
