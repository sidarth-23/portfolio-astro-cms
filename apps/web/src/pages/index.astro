---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import type { HomePage, Post, Project } from "@sidshub/cms-config/payload-types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import {
  categoryFromPost,
  getHomePage,
  mediaToUrl,
  seriesFromPost,
  tagsFromPost,
} from "@/lib/cms/client";

const homePage: HomePage = await getHomePage();
const isPost = (value: number | Post): value is Post =>
  typeof value === "object" && value !== null && value._status !== "draft";
const isProject = (value: number | Project | null | undefined): value is Project =>
  typeof value === "object" && value !== null && value._status !== "draft";
type CtaButton = NonNullable<HomePage["ctaButtons"]>[number];
type ButtonVariant = NonNullable<CtaButton["variant"]>;
const variantToButtonClass: Record<ButtonVariant, string> = {
  default: "",
  primary: "btn-primary",
  secondary: "btn-secondary",
  accent: "btn-accent",
  outline: "btn-outline",
  ghost: "btn-ghost",
};
const resolveCtaHref = (button: CtaButton): string | undefined => {
  const link = button.link;
  if (!link) {
    return undefined;
  }

  if (link.type === "custom") {
    return link.url ?? undefined;
  }

  const reference = link.reference;
  if (!reference || typeof reference === "number") {
    return undefined;
  }

  if (reference.relationTo === "posts" && isPost(reference.value) && reference.value.slug) {
    return `/blog/${reference.value.slug}`;
  }

  if (reference.relationTo === "projects" && isProject(reference.value) && reference.value.slug) {
    return `/projects#${reference.value.slug}`;
  }

  return undefined;
};
const ctaButtons =
  homePage.ctaButtons?.flatMap((button) => {
    const title = button.title?.trim();
    const href = resolveCtaHref(button);

    if (!title || !href) {
      return [];
    }

    return [
      {
        title,
        href,
        variant: button.variant ?? "default",
        newTab: button.link?.newTab === true,
      },
    ];
  }) ?? [];
const featuredSections = homePage.featuredSections ?? [];
---

<BaseLayout
  title="Home"
  seoTitle={homePage?.meta?.title}
  description={homePage?.meta?.description}
  image={mediaToUrl(homePage?.meta?.image)}
  canonicalUrl={homePage?.seoOverrides?.canonicalUrl ?? undefined}
  robotsIndex={homePage?.seoOverrides?.robotsIndex ?? undefined}
  robotsFollow={homePage?.seoOverrides?.robotsFollow ?? undefined}
  sideBarActiveItemID="home"
>
  <div>
    <div class="text-xl py-1">{homePage?.greeting}</div>
    <div class="text-5xl font-bold">{homePage?.name}</div>
    <div class="text-3xl py-3 font-bold">
      {homePage?.role}
    </div>

    <div class="prose prose-lg py-2 max-w-none">
      <RichTextRenderer data={homePage.about} />
    </div>

    {ctaButtons.length > 0 && (
      <div class="mt-6 flex gap-4 flex-wrap">
        {ctaButtons.map((button) => (
          <a
            class={`btn md:btn-lg ${variantToButtonClass[button.variant]}`}
            href={button.href}
            target={button.newTab ? "_blank" : undefined}
            rel={button.newTab ? "noopener noreferrer" : undefined}
          >
            {button.title}
          </a>
        ))}
      </div>
    )}
  </div>

  {featuredSections.length > 0 && (
    <div class="mt-14 flex flex-col gap-12">
      {featuredSections.map((section) => (
        <section>
          <div class="mb-6">
            <h2 class="text-3xl w-full font-bold my-2">{section.name}</h2>
            {section.description && (
              <div class="prose prose-lg max-w-none">
                <RichTextRenderer data={section.description} />
              </div>
            )}
          </div>

          {section.posts
            ?.filter(isPost)
            .map((post) => (
              <>
                <HorizontalCard
                  title={post.title}
                  img={mediaToUrl(post.coverImage)}
                  desc={post.excerpt}
                  url={`/blog/${post.slug}`}
                  target="_self"
                  category={categoryFromPost(post)}
                  tags={tagsFromPost(post)}
                  series={seriesFromPost(post)}
                />
                <div class="divider my-0" />
              </>
            ))}
        </section>
      ))}
    </div>
  )}
</BaseLayout>
