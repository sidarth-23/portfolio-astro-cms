---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import { ASTRO_CMS_API_URL, ASTRO_CMS_READ_TOKEN } from "astro:env/server";
import { createCmsRestClient } from "@sidshub/cms-config/rest-client";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";

const cmsClient = createCmsRestClient({ apiUrl: ASTRO_CMS_API_URL, token: ASTRO_CMS_READ_TOKEN });

const homePage = await cmsClient.getHomePage();
const { meta } = homePage;

if (!meta.title || !meta.description) {
  throw new Error("Home page requires SEO `meta.title` and `meta.description`.");
}

const variantToButtonClass = {
  default: "",
  primary: "btn-primary",
  secondary: "btn-secondary",
  accent: "btn-accent",
  outline: "btn-outline",
  ghost: "btn-ghost",
} as const;
const ctaButtons = cmsClient.homeCtaButtons(homePage);
const featuredSections = homePage.featuredSections ?? [];
---

<BaseLayout
  title="Home"
  seoTitle={meta.title}
  description={meta.description}
  image={cmsClient.mediaToUrl(meta?.image)}
>
  <div>
    <div class="text-xl py-1">{homePage?.greeting}</div>
    <div class="text-5xl font-bold">{homePage?.name}</div>
    <div class="text-3xl py-3 font-bold">
      {homePage?.role}
    </div>

    <div class="prose prose-lg py-2 max-w-none">
      <RichTextRenderer data={homePage.about} />
    </div>

    {ctaButtons.length > 0 && (
      <div class="mt-6 flex gap-4 flex-wrap">
        {ctaButtons.map((button) => (
          <a
            class={`btn md:btn-lg ${variantToButtonClass[button.variant as keyof typeof variantToButtonClass]}`}
            href={button.href}
            target={button.newTab ? "_blank" : undefined}
            rel={button.newTab ? "noopener noreferrer" : undefined}
          >
            {button.title}
          </a>
        ))}
      </div>
    )}
  </div>

  {featuredSections.length > 0 && (
    <div class="mt-14 flex flex-col gap-12">
      {featuredSections.map((section) => (
        <section>
          <div class="mb-6">
            <h2 class="text-3xl w-full font-bold my-2">{section.name}</h2>
            {section.description && (
              <div class="prose prose-lg max-w-none">
                <RichTextRenderer data={section.description} />
              </div>
            )}
          </div>

          {cmsClient.featuredPostsFromHomeSection(section).map((post) => (
              <>
                <HorizontalCard
                  title={post.title}
                  img={cmsClient.mediaToUrl(post.coverImage)}
                  desc={post.excerpt}
                  url={`/blog/${post.slug}`}
                  target="_self"
                  category={cmsClient.categoryFromPost(post)}
                  tags={cmsClient.tagsFromPost(post)}
                  series={cmsClient.seriesFromPost(post)}
                />
                <div class="divider my-0" />
              </>
            ))}
        </section>
      ))}
    </div>
  )}
</BaseLayout>
