---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import type { HomePage } from "@sidshub/cms-core/payload-types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import { cmsClient } from "@/lib/cms";

const homePage: HomePage = await cmsClient.getHomePage();
const { meta } = homePage;

if (!meta.title || !meta.description) {
  throw new Error("Home page requires SEO `meta.title` and `meta.description`.");
}

type ButtonVariant = NonNullable<NonNullable<HomePage["ctaButtons"]>[number]["variant"]>;
const variantToButtonClass: Record<ButtonVariant, string> = {
  default: "",
  primary: "btn-primary",
  secondary: "btn-secondary",
  accent: "btn-accent",
  outline: "btn-outline",
  ghost: "btn-ghost",
};

const ctaButtons = cmsClient.homeCtaButtons(homePage);
const featuredSections = homePage.featuredSections ?? [];
---

<BaseLayout
  title="Home"
  seoTitle={meta.title}
  description={meta.description}
  image={cmsClient.mediaToUrl(meta?.image)}
>
  <div>
    <div class="text-xl py-1">{homePage?.greeting}</div>
    <div class="text-5xl font-bold">{homePage?.name}</div>
    <div class="text-3xl py-3 font-bold">
      {homePage?.role}
    </div>

    <div class="prose prose-lg py-2 max-w-none">
      <RichTextRenderer data={homePage.about} />
    </div>

    {
      ctaButtons.length > 0 && (
        <div class="mt-6 flex gap-4 flex-wrap">
          {ctaButtons.map((button) => (
            <a
              class={`btn md:btn-lg ${variantToButtonClass[button.variant]}`}
              href={button.href}
              target={button.newTab ? "_blank" : undefined}
              rel={button.newTab ? "noopener noreferrer" : undefined}
            >
              {button.title}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    featuredSections.length > 0 && (
      <div class="mt-14 flex flex-col gap-12">
        {featuredSections.map((section) => (
          <section>
            <div class="mb-6">
              <h2 class="text-3xl w-full font-bold my-2">{section.name}</h2>
              {section.description && (
                <div class="prose prose-lg max-w-none">
                  <RichTextRenderer data={section.description} />
                </div>
              )}
            </div>

            {(section.sourceCollection === "posts" || !section.sourceCollection) &&
              cmsClient.featuredPostsFromHomeSection(section).map((post) => (
                <>
                  <HorizontalCard
                    title={post.title}
                    img={cmsClient.mediaToUrl(post.coverImage)}
                    desc={post.description}
                    url={`/blog/${post.slug}`}
                    category={cmsClient.categoryFromPost(post)}
                    tags={cmsClient.tagsFromPost(post)}
                    series={cmsClient.seriesFromPost(post)}
                  />
                  <div class="divider my-0" />
                </>
              ))}

            {section.sourceCollection === "projects" &&
              cmsClient.featuredProjectsFromHomeSection(section).map((project) => (
                <>
                  <HorizontalCard
                    title={project.title}
                    img={cmsClient.mediaToUrl(project.image)}
                    desc={project.description}
                    url={"/projects/" + project.slug}
                    badges={cmsClient.badgesFromProject(project)}
                    tags={cmsClient.tagsFromProject(project)}
                    links={cmsClient.linksFromProject(project)}
                  />
                  <div class="divider my-0" />
                </>
              ))}
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
