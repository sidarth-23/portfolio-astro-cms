---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import {
  categoryFromPost,
  getFeaturedPublishedPosts,
  getHomePage,
  mediaToUrl,
  tagsFromPost,
} from "@/lib/cms/client";

const [homePage, posts] = await Promise.all([
  getHomePage(),
  getFeaturedPublishedPosts(3),
]);
---

<BaseLayout
  title={homePage?.meta?.title}
  description={homePage?.meta?.description}
  image={mediaToUrl(homePage?.meta?.image)}
  canonicalUrl={homePage?.seoOverrides?.canonicalUrl}
  robotsIndex={homePage?.seoOverrides?.robotsIndex}
  robotsFollow={homePage?.seoOverrides?.robotsFollow}
  sideBarActiveItemID="home"
>
  <div class="py-10">
    <div class="text-xl py-1">{homePage?.greeting}</div>
    <div class="text-5xl font-bold">{homePage?.name}</div>
    <div class="text-3xl py-3 font-bold">
      {homePage?.role}
    </div>

    <div class="prose prose-lg py-2 max-w-none">
      <RichTextRenderer data={homePage.about} />
    </div>

    <div class="mt-6 flex gap-4">
      <a class="btn md:btn-lg" href={homePage?.ctaPrimaryUrl} target="_blank">
        {homePage?.ctaPrimaryLabel}
      </a>
      <a href={homePage?.ctaSecondaryUrl} class="btn btn-outline md:btn-lg">
        {homePage?.ctaSecondaryLabel}
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold my-5">
      {homePage?.featuredSectionTitle}
    </div>
  </div>

  {
    posts.map((post) => (
      <>
        <HorizontalCard
          title={post.title}
          img={mediaToUrl(post.coverImage)}
          desc={post.excerpt}
          url={`/blog/${post.slug}`}
          target="_self"
          category={categoryFromPost(post)}
          tags={tagsFromPost(post)}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
