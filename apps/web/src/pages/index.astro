---
import { RichTextRenderer } from "@sidshub/lexical/web";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import {
  categoryFromPost,
  getAllPublishedPosts,
  getHomePage,
  mediaToUrl,
  tagsFromPost,
} from "@/lib/cms/client";

const [homePage, posts] = await Promise.all([getHomePage(), getAllPublishedPosts()]);

const latestPosts = posts.slice(0, 3);

const fallbackAbout =
  "I'm just a random guy on the internet tinkering around with various tools around and having a fun time around. To feed myself, I do a job of a Backend developer with my tech stack around the Go language ecosystem.";
---

<BaseLayout
  title={homePage?.meta?.title || "Home"}
  description={homePage?.meta?.description || "Welcome to my website!"}
  image={mediaToUrl(homePage?.meta?.image)}
  canonicalUrl={homePage?.seoOverrides?.canonicalUrl}
  robotsIndex={homePage?.seoOverrides?.robotsIndex}
  robotsFollow={homePage?.seoOverrides?.robotsFollow}
  sideBarActiveItemID="home"
>
  <div class="py-6">
    <div class="text-xl py-1">{homePage?.greeting || "Hey there 👋"}</div>
    <div class="text-5xl font-bold">{homePage?.name || "I'm Sidarth G"}</div>
    <div class="text-3xl py-3 font-bold">{homePage?.role || "Full Stack Developer"}</div>

    {
      homePage?.about ? (
        <RichTextRenderer className="text-lg py-2" data={homePage.about} />
      ) : (
        <p class="text-lg whitespace-pre-line py-2">{fallbackAbout}</p>
      )
    }

    <div class="mt-8">
      <a class="btn" href={homePage?.ctaPrimaryUrl || "https://linkedin.com/in/sidarth-g"} target="_blank">
        {homePage?.ctaPrimaryLabel || "Let's connect!"}
      </a>
      <a href={homePage?.ctaSecondaryUrl || "/cv"} class="btn btn-outline ml-5">
        {homePage?.ctaSecondaryLabel || "View My CV"}
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">{homePage?.latestBlogTitle || "Latest from blog"}</div>
  </div>

  {
    latestPosts.map((post) => (
      <>
        <HorizontalCard
          title={post.title}
          img={mediaToUrl(post.coverImage)}
          desc={post.excerpt}
          url={`/blog/${post.slug}`}
          target="_self"
          category={categoryFromPost(post)}
          tags={tagsFromPost(post)}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
