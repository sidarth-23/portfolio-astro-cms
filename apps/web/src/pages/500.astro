---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
---

<ErrorLayout
  title="500: Server Error"
  description="Something went wrong while loading this page."
>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">⚠️</h1>
    <h1 class="text-7xl font-bold mb-2">500</h1>
    <h3 class="text-2xl">Something went wrong while loading this page.</h3>
    <a class="btn btn-accent mt-9" href="/">Home</a>
  </div>
</ErrorLayout>
