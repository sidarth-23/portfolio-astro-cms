---
import NotFoundState from "@/components/NotFoundState.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { getErrorPageSeo } from "@/lib/seo";

const seo = await getErrorPageSeo();
---

<ErrorLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
>
  <NotFoundState
    title="500"
    description="Something went wrong while loading this page."
    ctaLabel="Home"
    ctaHref="/"
    emoji="⚠️"
  />
</ErrorLayout>
