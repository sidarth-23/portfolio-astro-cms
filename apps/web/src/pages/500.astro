---
export const prerender = false;
import NotFoundState from "@/components/NotFoundState.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { getErrorPageSeo } from "@/lib/seo";
import { PhWarningCircle } from "phosphor-icons-astro";

const seo = await getErrorPageSeo();
---

<ErrorLayout title={seo.title} description={seo.description} image={seo.image}>
  <NotFoundState
    title="Something went wrong"
    description="We ran into an unexpected error. Please try again later."
    ctaLabel="Back to home"
    ctaHref="/"
    icon={PhWarningCircle}
  />
</ErrorLayout>
