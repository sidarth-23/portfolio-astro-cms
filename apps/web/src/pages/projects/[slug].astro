---
import NotFoundState from "@/components/NotFoundState.astro";
import ProjectDetailEnhancers from "@/components/ProjectDetailEnhancers.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolveIcon } from "@/lib/resolveIcon";
import { cmsClient } from "@/lib/cms";
import { getErrorPageSeo } from "@/lib/seo";
import { PhMagnifyingGlass } from "phosphor-icons-astro";

export const prerender = false;

const slug = Astro.params.slug;
const project = slug ? await cmsClient.getProjectBySlug(slug) : null;
const missingProject = !slug || !project;

const errorSeo = missingProject ? await getErrorPageSeo() : null;

if (project?.meta && (!project.meta.title || !project.meta.description)) {
  throw new Error(
    `Project "${project.slug}" requires SEO \`meta.title\` and \`meta.description\`.`,
  );
}

const tags = project ? cmsClient.tagsFromProject(project) : [];
const badges = project ? cmsClient.badgesFromProject(project) : [];
const links = project ? cmsClient.linksFromProject(project) : [];
const coverImage = project ? cmsClient.mediaToUrl(project.coverImage) : undefined;
---

{
  missingProject && errorSeo ? (
    <ErrorLayout title={errorSeo.title} description={errorSeo.description} image={errorSeo.image}>
      <NotFoundState
        title="404"
        description="The project you're looking for couldn't be found."
        ctaLabel="Projects"
        ctaHref="/projects"
        icon={PhMagnifyingGlass}
      />
    </ErrorLayout>
  ) : (
    project && (
      <BaseLayout
        title={project.title}
        seoTitle={project.meta.title}
        description={project.meta.description}
        image={cmsClient.mediaToUrl(project.meta.image) ?? coverImage}
      >
        <article class="mx-auto w-full max-w-5xl px-6 py-14">
          <div class="mb-6">
            <a
              href="/projects"
              class="text-sm font-medium text-base-content/60 transition-colors hover:text-base-content"
            >
              Back to projects
            </a>
          </div>

          {coverImage && (
            <img
              src={coverImage}
              alt={project.title}
              class="mb-8 w-full rounded-3xl border border-base-content/10 object-cover shadow-sm"
              loading="eager"
            />
          )}

          <header class="mb-8">
            <div class="flex flex-wrap gap-2">
              {badges.map((badge) => (
                <span class="badge badge-accent badge-outline">{badge}</span>
              ))}
            </div>

            <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{project.title}</h1>
            <p class="mt-4 max-w-3xl text-lg leading-8 text-base-content/75">
              {project.description}
            </p>

            {(tags.length > 0 || links.length > 0) && (
              <div class="mt-6 flex flex-wrap items-center gap-3">
                {tags.map((tag) => (
                  <span class="inline-flex items-center gap-1 rounded-full border border-base-content/12 bg-base-200/40 px-3 py-1 text-xs font-medium text-base-content/75">
                    <span class="text-base-content/30">#</span>
                    {tag.name}
                  </span>
                ))}

                {links.map((link) => {
                  const iconData = resolveIcon(link.icon);
                  if (!iconData) return null;

                  const PhosphorIcon = iconData.source === "phosphor" ? iconData.component : null;
                  const label = iconData.source === "simple-icons" ? iconData.title : iconData.name;

                  return (
                    <a
                      href={link.url}
                      target={link.newTab ? "_blank" : undefined}
                      rel={link.newTab ? "noopener noreferrer" : undefined}
                      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-base-content/15 bg-base-200/40 text-base-content/60 transition-colors hover:text-base-content"
                      aria-label={label}
                      title={label}
                    >
                      {iconData.source === "simple-icons" && (
                        <svg
                          width={18}
                          height={18}
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                          fill="currentColor"
                        >
                          <path d={iconData.path} />
                        </svg>
                      )}
                      {PhosphorIcon && <PhosphorIcon size={18} />}
                    </a>
                  );
                })}
              </div>
            )}
          </header>

          <div class="prose prose-lg max-w-none prose-img:mx-auto">
            <RichTextRenderer data={project.content} calloutVariantProfile="generic" />
          </div>
        </article>

        <ProjectDetailEnhancers />
      </BaseLayout>
    )
  )
}
