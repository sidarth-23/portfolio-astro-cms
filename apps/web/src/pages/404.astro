---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { cmsClient } from "@/lib/cms";
const {
  title: pageTitle,
  description: pageDescription,
  meta,
  ctaLabel,
  ctaHref,
  emoji,
} = await cmsClient.getNotFoundPage();

if (!pageTitle || !pageDescription || !meta.title || !meta.description) {
  throw new Error(
    "404 page requires `title`, `description`, and SEO `meta.title` + `meta.description`.",
  );
}
---

<ErrorLayout
  title={meta.title}
  description={meta.description}
  image={cmsClient.mediaToUrl(meta?.image)}
>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">{emoji}</h1>
    <h1 class="text-9xl font-bold mb-2">{pageTitle}</h1>
    <h3 class="text-2xl">{pageDescription}</h3>
    <a class="btn btn-accent mt-9" href={ctaHref}>{ctaLabel}</a>
  </div>
</ErrorLayout>
