---
import NotFoundState from "@/components/NotFoundState.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { getErrorPageSeo } from "@/lib/seo";

const seo = await getErrorPageSeo();
---

<ErrorLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
>
  <NotFoundState
    title="404"
    description="The page you're looking for couldn't be found."
    ctaLabel="Home"
    ctaHref="/"
    emoji="🏝"
  />
</ErrorLayout>
