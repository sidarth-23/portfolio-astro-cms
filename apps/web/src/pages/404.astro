---
import NotFoundState from "@/components/NotFoundState.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { getErrorPageSeo } from "@/lib/seo";
import { PhMagnifyingGlass } from "phosphor-icons-astro";

const seo = await getErrorPageSeo();
---

<ErrorLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
>
  <NotFoundState
    title="Page not found"
    description="The page you're looking for doesn't exist or may have been moved."
    ctaLabel="Back to home"
    ctaHref="/"
    icon={PhMagnifyingGlass}
  />
</ErrorLayout>
