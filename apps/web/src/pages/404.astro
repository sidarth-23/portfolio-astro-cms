---
import NotFoundState from "@/components/NotFoundState.astro";
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { cmsClient } from "@/lib/cms";
const {
  title: pageTitle,
  description: pageDescription,
  meta,
  ctaLabel,
  ctaHref,
  emoji,
} = await cmsClient.getNotFoundPage();

if (!pageTitle || !pageDescription || !meta.title || !meta.description) {
  throw new Error(
    "404 page requires `title`, `description`, and SEO `meta.title` + `meta.description`.",
  );
}
---

<ErrorLayout
  title={meta.title}
  description={meta.description}
  image={cmsClient.mediaToUrl(meta?.image)}
>
  <NotFoundState
    title={pageTitle}
    description={pageDescription}
    ctaLabel={ctaLabel}
    ctaHref={ctaHref}
    emoji={emoji}
  />
</ErrorLayout>
