---
import type { SiteFooterItem } from "@sidshub/cms-core/client";
import { resolveIcon } from "@/lib/resolveIcon";

type Props = {
  items?: SiteFooterItem[];
};

const { items = [] }: Props = Astro.props;

const cleanItems = items
  .flatMap((item) => {
    if (!item?.icon || item.url.length === 0) {
      return [];
    }

    const iconData = resolveIcon(item.icon);
    if (!iconData) {
      return [];
    }

    return [{ item, iconData }];
  })
  .slice(0, 4);
---

<div
  class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

{
  cleanItems.length > 0 && (
    <div class="social-icons px-4 pb-5 pt-1 flex flex-wrap gap-4 self-center justify-center sticky bottom-0 bg-base-200 group-[.collapsed]:px-1">
      {cleanItems.map(({ item, iconData }) => {
        const PhosphorIcon = iconData.source === "phosphor" ? iconData.component : null;

        return (
          <a
            href={item.url}
            target={item.newTab ? "_blank" : undefined}
            rel={item.newTab ? "noreferrer noopener" : undefined}
            class="mx-3 group-[.collapsed]:mx-1 hover:text-primary transition-colors"
            aria-label={iconData.source === "simple-icons" ? iconData.title : iconData.name}
            title={iconData.source === "simple-icons" ? iconData.title : iconData.name}
          >
            {iconData.source === "simple-icons" && (
              <svg
                width={24}
                height={24}
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="currentColor"
              >
                <title>{iconData.title}</title>
                <path d={iconData.path} />
              </svg>
            )}
            {PhosphorIcon && <PhosphorIcon size={24} weight="regular" />}
          </a>
        );
      })}
    </div>
  )
}
