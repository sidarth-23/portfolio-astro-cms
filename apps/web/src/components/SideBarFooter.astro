---
import type { ResolvedLink } from "@/lib/types";

type Props = {
  items?: ResolvedLink[];
};

const { items = [] }: Props = Astro.props;
---

<div
  class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

{
  items.length > 0 && (
    <div class="social-icons px-4 pb-5 pt-1 flex flex-wrap gap-4 self-center justify-center sticky bottom-0 bg-base-200">
      {items.map((item) => (
        <a
          href={item.url}
          target={item.newTab ? "_blank" : undefined}
          rel={item.newTab ? "noreferrer noopener" : undefined}
          class="mx-3 hover:text-primary transition-colors"
          aria-label={item.label}
          title={item.label}
        >
          <svg
            viewBox={item.viewBox}
            width={24}
            height={24}
            aria-hidden="true"
            class="h-6 w-6 fill-current stroke-current"
            set:html={item.innerSvg}
          />
        </a>
      ))}
    </div>
  )
}
