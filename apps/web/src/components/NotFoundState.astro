---
type Props = {
  title: string;
  description: string;
  ctaLabel?: string | null;
  ctaHref?: string | null;
  icon?: any;
};

const { title, description, ctaLabel, ctaHref, icon: Icon } = Astro.props;
const hasCta = Boolean(ctaLabel && ctaHref);
---

<div class="mx-auto max-w-sm text-center">
  {
    Icon && (
      <Icon
        class="mx-auto text-base-content/30"
        size={80}
        weight="light"
      />
    )
  }
  <h2 class="mt-6 text-2xl font-bold">{title}</h2>
  <p class="mt-3 text-pretty text-base-content/60">{description}</p>
  {
    hasCta && (
      <a class="btn btn-accent mt-8 w-full" href={ctaHref ?? undefined}>
        {ctaLabel}
      </a>
    )
  }
</div>
