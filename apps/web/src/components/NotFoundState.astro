---
type Props = {
  title: string;
  description: string;
  ctaLabel?: string | null;
  ctaHref?: string | null;
  emoji?: string | null;
};

const { title, description, ctaLabel, ctaHref, emoji } = Astro.props;
const hasCta = Boolean(ctaLabel && ctaHref);
---

<div class="text-center">
  {emoji && <h1 class="mb-4 text-9xl font-bold">{emoji}</h1>}
  <h1 class="mb-2 text-9xl font-bold">{title}</h1>
  <h3 class="text-2xl">{description}</h3>
  {
    hasCta && (
      <a class="btn btn-accent mt-9" href={ctaHref ?? undefined}>
        {ctaLabel}
      </a>
    )
  }
</div>