<script is:inline>
  (() => {
    const STORAGE_KEY = "theme-preference";
    const LIGHT_THEME = "emerald";
    const DARK_THEME = "night";
    const THEME_VALUES = new Set(["light", "dark", "system"]);
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

    const toPreference = (value) => (THEME_VALUES.has(value) ? value : "system");
    const getPreference = () => toPreference(localStorage.getItem(STORAGE_KEY));
    const getResolvedMode = (preference) =>
      preference === "system" ? (mediaQuery.matches ? "dark" : "light") : preference;

    const applyToDocument = (targetDocument, preference) => {
      const mode = getResolvedMode(preference);
      const themeName = mode === "dark" ? DARK_THEME : LIGHT_THEME;

      targetDocument.documentElement.dataset.theme = themeName;
      targetDocument.documentElement.style.colorScheme = mode;
    };

    const apply = () => {
      applyToDocument(document, getPreference());
      document.dispatchEvent(new CustomEvent("theme:changed"));
    };

    const setPreference = (nextPreference) => {
      const preference = toPreference(nextPreference);
      localStorage.setItem(STORAGE_KEY, preference);
      apply();
    };

    if (!window["__theme"]) {
      window["__theme"] = {
        getPreference,
        setPreference,
        apply,
      };
    }

    applyToDocument(document, getPreference());

    if (!window["__themeManagerInitialized"]) {
      mediaQuery.addEventListener("change", () => {
        if (getPreference() === "system") {
          apply();
        }
      });

      document.addEventListener("astro:before-swap", (event) => {
        const nextDocument = event.newDocument;
        if (!nextDocument) {
          return;
        }
        applyToDocument(nextDocument, getPreference());
      });

      document.addEventListener("astro:after-swap", () => {
        applyToDocument(document, getPreference());
      });

      window["__themeManagerInitialized"] = true;
    }
  })();
</script>
