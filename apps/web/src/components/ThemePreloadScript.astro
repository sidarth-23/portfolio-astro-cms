<script is:inline>
  window.theme ??= (() => {
    const STORAGE_KEY = "theme-preference";
    const LIGHT = "emerald";
    const DARK = "night";
    const VALID = new Set(["light", "dark", "system"]);
    const mq = window.matchMedia("(prefers-color-scheme: dark)");

    function parse(v) {
      return VALID.has(v) ? v : "system";
    }

    function getPreference() {
      try {
        return parse(localStorage.getItem(STORAGE_KEY));
      } catch {
        return "system";
      }
    }

    function resolve(pref) {
      return pref === "system" ? (mq.matches ? "dark" : "light") : pref;
    }

    function applyTo(doc, pref) {
      const mode = resolve(pref ?? getPreference());
      doc.documentElement.dataset.theme = mode === "dark" ? DARK : LIGHT;
      doc.documentElement.style.colorScheme = mode;
    }

    function apply() {
      applyTo(document, getPreference());
    }

    function setPreference(value) {
      const pref = parse(value);
      try {
        localStorage.setItem(STORAGE_KEY, pref);
      } catch {}
      apply();
      document.dispatchEvent(new CustomEvent("theme:changed"));
    }

    // Registered once inside ??= — no guard flag needed
    mq.addEventListener("change", () => {
      if (getPreference() === "system") {
        apply();
        document.dispatchEvent(new CustomEvent("theme:changed"));
      }
    });

    // Apply theme to incoming document before ViewTransition swap
    document.addEventListener("astro:before-swap", (e) => {
      if (e.newDocument) applyTo(e.newDocument, getPreference());
    });

    return { getPreference, setPreference, apply };
  })();

  // Runs on every navigation — ??= skips the IIFE but apply() re-runs
  window.theme.apply();
</script>
