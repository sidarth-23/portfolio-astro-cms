---
import { PhLink } from "phosphor-icons-astro";

const { title, subtitle, url } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1"></span>
    <span class="education__line bg-primary block h-full w-[2px] translate-x-[7px]"></span>
  </div>
  <div class="experience__data bd-grid px-5">
    <div class="flex items-center gap-2 mb-1">
      <h3 class="font-semibold">{title}</h3>
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class="opacity-50 hover:opacity-100 transition-opacity">
          <PhLink size={18} />
        </a>
      )}
    </div>
    <span class="font-light text-sm">{subtitle}</span>
    <p class="my-2 text-justify">
      <slot />
    </p>
  </div>
</div>

