---
type Props = {
  name: string;
  role: string;
  profileImage?: string;
};

const { name, role, profileImage }: Props = Astro.props;
---

<div class="flex flex-col items-center gap-4 py-8 mb-6">
  <div class="avatar">
    <div class="w-20 rounded-full ring-2 ring-primary/40 ring-offset-2 ring-offset-base-100">
      {
        profileImage ? (
          <img
            src={profileImage}
            alt={name}
            loading="eager"
            fetchpriority="high"
            width={300}
            height={300}
            class="object-cover"
          />
        ) : (
          <div class="w-full h-full bg-base-300" aria-hidden="true" />
        )
      }
    </div>
  </div>

  <div class="flex flex-col items-center gap-1 text-center">
    <h1 class="text-3xl font-bold">{name}</h1>
    <p class="text-sm tracking-wider text-base-content/60">{role}</p>
  </div>

  <div class="h-0.5 w-14 rounded-full bg-primary"></div>
</div>
