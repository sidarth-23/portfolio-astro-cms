---
import { PhHouse, PhBriefcase, PhNewspaper } from "phosphor-icons-astro";

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
---

<ul class="menu grow shrink menu-md overflow-y-auto w-full">
  <li>
    <a class="py-3 text-base flex items-center gap-4" id="home" href="/">
      <PhHouse size={24} />
      <span class="group-[.collapsed]:hidden">Home</span>
    </a>
  </li>
  <li>
    <a
      class="py-3 text-base flex items-center gap-4"
      id="projects"
      href="/projects"
    >
      <PhBriefcase size={24} />
      <span class="group-[.collapsed]:hidden">Projects</span>
    </a>
  </li>
  <li>
    <a class="py-3 text-base flex items-center gap-4" id="blog" href="/blog/">
      <PhNewspaper size={24} />
      <span class="group-[.collapsed]:hidden">Blog</span>
    </a>
  </li>
</ul>

<script
  is:inline
  define:vars={{
    sideBarActiveItemID: sideBarActiveItemID,
    activeClass: activeClass,
  }}
>
  const activeItemElem = document.getElementById(sideBarActiveItemID);
  activeItemElem && activeItemElem.classList.add(activeClass);
</script>
