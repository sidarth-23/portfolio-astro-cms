---
import { PhHouse, PhBriefcase, PhNewspaper, PhFileText } from "phosphor-icons-astro";

const menuItems = [
  { id: "home", href: "/", label: "Home", Icon: PhHouse },
  { id: "projects", href: "/projects", label: "Projects", Icon: PhBriefcase },
  { id: "blog", href: "/blog/", label: "Blog", Icon: PhNewspaper },
  { id: "cv", href: "/cv", label: "Resume", Icon: PhFileText },
] as const;

const linkClass =
  "py-3 text-base flex items-center gap-4 group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0";
const labelClass =
  "inline-block overflow-hidden whitespace-nowrap transition-[max-width,opacity,margin] duration-300 ease-in-out max-w-24 opacity-100 group-[.collapsed]:max-w-0 group-[.collapsed]:opacity-0";
const activeClass = "is-active";
---

<ul id="sidebar-menu" class="menu grow shrink menu-md overflow-y-auto w-full">
  {
    menuItems.map(({ id, href, label, Icon }) => (
      <li>
        <a class={linkClass} id={id} href={href} data-sidebar-item>
          <Icon size={24} />
          <span class={labelClass}>{label}</span>
        </a>
      </li>
    ))
  }
</ul>

<script is:inline define:vars={{ activeClass: activeClass }}>
  const normalizePath = (path) => {
    if (typeof path !== "string" || path === "") {
      return "/";
    }

    const normalizedPath = path.endsWith("/") && path !== "/" ? path.slice(0, -1) : path;

    return normalizedPath || "/";
  };

  const matchesPath = (currentPath, itemPath) => {
    if (itemPath === "/") {
      return currentPath === "/";
    }

    return currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
  };

  const setActiveMenuItem = () => {
    const menuElem = document.getElementById("sidebar-menu");
    if (!menuElem) {
      return;
    }

    const currentPath = normalizePath(window.location.pathname);
    const menuItems = menuElem.querySelectorAll("[data-sidebar-item]");
    menuItems.forEach((item) => item.classList.remove(activeClass));

    for (const item of menuItems) {
      const itemPath = normalizePath(item.getAttribute("href") || "/");
      if (matchesPath(currentPath, itemPath)) {
        item.classList.add(activeClass);
        break;
      }
    }
  };

  setActiveMenuItem();

  if (!document.documentElement.dataset.sidebarMenuPageLoadBound) {
    document.addEventListener("astro:page-load", setActiveMenuItem);
    document.documentElement.dataset.sidebarMenuPageLoadBound = "true";
  }
</script>

<style>
  #sidebar-menu :global(a.is-active) {
    background-color: var(--color-base-300);
  }
</style>
