---
type Props = {
  currentPage: number;
  totalPages: number;
  buildPageUrl: (page: number) => string;
};

const { currentPage, totalPages, buildPageUrl } = Astro.props;

// Generate page numbers with ellipsis
const generatePageNumbers = (): (number | "ellipsis")[] => {
  if (totalPages <= 7) {
    // Show all pages if 7 or fewer
    return Array.from({ length: totalPages }, (_, i) => i + 1);
  }

  const pages: (number | "ellipsis")[] = [];

  // Always show first page
  pages.push(1);

  if (currentPage <= 3) {
    // Near the start: [1] [2] [3] [4] [...] [last]
    pages.push(2, 3, 4);
    if (totalPages > 5) {
      pages.push("ellipsis");
    }
  } else if (currentPage >= totalPages - 2) {
    // Near the end: [1] [...] [last-3] [last-2] [last-1] [last]
    pages.push("ellipsis");
    pages.push(totalPages - 3, totalPages - 2, totalPages - 1);
  } else {
    // In the middle: [1] [...] [current-1] [current] [current+1] [...] [last]
    pages.push("ellipsis");
    pages.push(currentPage - 1, currentPage, currentPage + 1);
    pages.push("ellipsis");
  }

  // Always show last page
  if (!pages.includes(totalPages)) {
    pages.push(totalPages);
  }

  return pages;
};

const pageNumbers = generatePageNumbers();
---

<div class="join">
  {/* Previous button */}
  {currentPage > 1 ? (
    <a href={buildPageUrl(currentPage - 1)} class="join-item btn btn-sm">
      «
    </a>
  ) : (
    <button class="join-item btn btn-sm btn-disabled">
      «
    </button>
  )}

  {/* Page numbers */}
  {pageNumbers.map((page) => {
    if (page === "ellipsis") {
      return <button class="join-item btn btn-sm btn-disabled">...</button>;
    }

    if (page === currentPage) {
      return (
        <button class="join-item btn btn-sm btn-active">
          {page}
        </button>
      );
    }

    return (
      <a href={buildPageUrl(page)} class="join-item btn btn-sm">
        {page}
      </a>
    );
  })}

  {/* Next button */}
  {currentPage < totalPages ? (
    <a href={buildPageUrl(currentPage + 1)} class="join-item btn btn-sm">
      »
    </a>
  ) : (
    <button class="join-item btn btn-sm btn-disabled">
      »
    </button>
  )}
</div>
