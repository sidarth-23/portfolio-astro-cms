---
import { PhCheck, PhDesktop, PhMoon, PhSun } from "phosphor-icons-astro";
---

<div class="dropdown dropdown-end">
  <button
    type="button"
    class="btn btn-circle btn-ghost"
    aria-label="Select theme"
    title="Theme"
    data-theme-trigger
  >
    <span data-theme-icon="light" class="hidden">
      <PhSun size={18} />
    </span>
    <span data-theme-icon="dark" class="hidden">
      <PhMoon size={18} />
    </span>
    <span data-theme-icon="system" class="hidden">
      <PhDesktop size={18} />
    </span>
  </button>

  <ul
    tabindex="0"
    class="dropdown-content menu z-[70] mt-2 w-40 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
    data-theme-menu
  >
    <li>
      <button type="button" class="flex items-center justify-between" data-theme-option="light">
        <span class="flex items-center gap-2">
          <PhSun size={16} />
          <span>Light</span>
        </span>
        <PhCheck size={14} class="invisible" data-theme-check="light" />
      </button>
    </li>
    <li>
      <button type="button" class="flex items-center justify-between" data-theme-option="dark">
        <span class="flex items-center gap-2">
          <PhMoon size={16} />
          <span>Dark</span>
        </span>
        <PhCheck size={14} class="invisible" data-theme-check="dark" />
      </button>
    </li>
    <li>
      <button type="button" class="flex items-center justify-between" data-theme-option="system">
        <span class="flex items-center gap-2">
          <PhDesktop size={16} />
          <span>System</span>
        </span>
        <PhCheck size={14} class="invisible" data-theme-check="system" />
      </button>
    </li>
  </ul>
</div>
