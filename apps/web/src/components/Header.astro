---
import { PhList } from "phosphor-icons-astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import type { ResolvedLink } from "@/lib/types";

type Props = { footerItems?: ResolvedLink[] };
const { footerItems = [] } = Astro.props;
---

<top
  class="sticky top-0 z-30 flex h-16 w-full justify-center bg-opacity-90 backdrop-blur transition-all duration-100 bg-base-100 text-base-content shadow-sm"
>
  <div class="navbar">
    <div>
      <label for="my-drawer" class="btn btn-square btn-ghost" aria-label="Toggle sidebar">
        <PhList class="inline-block w-5 h-5" />
      </label>
    </div>
    <div class="flex-1"></div>
    <div class="menu menu-horizontal">
      {
        footerItems.map((item) => (
          <a
            href={item.url}
            target={item.newTab ? "_blank" : undefined}
            rel={item.newTab ? "noreferrer noopener" : undefined}
            class="btn btn-ghost btn-circle"
            aria-label={item.label}
            title={item.label}
          >
            <svg
              viewBox={item.viewBox}
              width={20}
              height={20}
              aria-hidden="true"
              class="fill-current stroke-current"
              set:html={item.innerSvg}
            />
          </a>
        ))
      }
      <ThemeSwitcher />
    </div>
  </div>
</top>
