---
import { PhList } from "phosphor-icons-astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";

type Props = { name: string };
const { name } = Astro.props;
---

<div
  class="sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-opacity-90 backdrop-blur transition-all duration-100 bg-base-100 text-base-content shadow-sm"
>
  <div class="navbar">
    <div class="navbar-start">
      <label for="my-drawer" class="btn btn-square btn-ghost">
        <PhList class="inline-block w-5 h-5" />
      </label>
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost normal-case text-xl" href="/">{name}</a>
    </div>
    <div class="navbar-end">
      <ThemeSwitcher />
    </div>
  </div>
</div>
