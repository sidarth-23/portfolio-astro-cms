---
type Props = {
  seriesName: string;
  seriesSlug: string;
  currentPart: number;
  totalParts: number;
  prevPost?: {
    slug: string;
    title: string;
  };
  nextPost?: {
    slug: string;
    title: string;
  };
};

const { seriesName, seriesSlug, currentPart, totalParts, prevPost, nextPost } = Astro.props;
---

<div class="bg-base-200 rounded-lg p-4 my-6">
  <div class="text-center mb-4">
    <a href={`/blog/series/${seriesSlug}`} class="font-bold text-lg hover:underline">
      {seriesName}
    </a>
    <div class="text-sm text-base-content/70 mt-1">
      Part {currentPart} of {totalParts}
    </div>
  </div>

  <div class="flex justify-between items-center gap-4">
    {
      prevPost ? (
        <a
          href={`/blog/${prevPost.slug}`}
          class="btn btn-ghost btn-sm flex-1 justify-start"
        >
          <svg
            class="h-4 w-4 fill-current flex-shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>
          <span class="truncate">{prevPost.title}</span>
        </a>
      ) : (
        <div class="flex-1" />
      )
    }

    {
      nextPost ? (
        <a
          href={`/blog/${nextPost.slug}`}
          class="btn btn-ghost btn-sm flex-1 justify-end"
        >
          <span class="truncate">{nextPost.title}</span>
          <svg
            class="h-4 w-4 fill-current flex-shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div class="flex-1" />
      )
    }
  </div>
</div>
