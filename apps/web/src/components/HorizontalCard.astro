---
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import { resolveIcon } from "@/lib/resolveIcon";
import type { RichTextValue } from "@sidshub/cms-editor/web/html";

type Tag = {
  name: string;
  slug: string;
};

type Category = {
  name: string;
  slug: string;
};

type Series = {
  name: string;
  slug: string;
};

type Props = {
  title: string;
  img?: string;
  desc?: string;
  descRich?: RichTextValue | null;
  url: string;
  badge?: string;
  badges?: string[];
  tags?: Tag[];
  category?: Category;
  series?: Series;
  target?: string;
  reverse?: boolean;
  links?: Array<{ icon: string; url: string; newTab: boolean }>;
};

const {
  title,
  img,
  desc = "",
  descRich,
  url,
  badges = [],
  tags = [],
  category,
  series,
  target = "_self",
  reverse = false,
  links = [],
} = Astro.props;
const contentClass = `hero-content flex-col ${reverse ? "md:flex-row-reverse" : "md:flex-row"} md:gap-8 lg:gap-10`;
---

<div
  class="card transition-colors duration-300 ease-in-out rounded-xl block hover:bg-base-content/5 group relative z-0"
>
  <a href={url} target={target} class="absolute inset-0 z-10" aria-label={title}
  ></a>
  {links && links.length > 0 && (
    <div class="absolute top-4 right-4 z-20 flex flex-col gap-1">
      {links.map((link) => {
        const iconData = resolveIcon(link.icon);
        if (!iconData) return null;
        const label = iconData.source === "simple-icons" ? iconData.title : iconData.name;
        return (
          <a
            href={link.url}
            target={link.newTab ? "_blank" : undefined}
            rel={link.newTab ? "noopener noreferrer" : undefined}
            title={label}
            aria-label={label}
            class="btn btn-circle btn-sm btn-ghost transition-all duration-300"
          >
            {iconData.source === "simple-icons" ? (
              <svg width={20} height={20} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d={iconData.path} />
              </svg>
            ) : (
              <iconData.component size={20} weight="regular" />
            )}
          </a>
        );
      })}
    </div>
  )}
  <div class={contentClass}>
    {
      img && (
        <div class="w-full md:w-56 h-40 md:h-40 flex-shrink-0 overflow-hidden rounded-lg">
          <img
            src={img}
            loading="lazy"
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
      )
    }
    <div class="grow w-full space-y-1">
      <div>
        {
          category && (
            <span class="badge badge-primary badge-sm mb-1">
              {category.name}
            </span>
          )
        }
        {
          series && (
            <span class="badge badge-secondary badge-sm mb-1 ml-1">
              {series.name}
            </span>
          )
        }
      </div>
      <h1
        class="text-xl font-bold decoration-2 underline-offset-4 flex items-center gap-2"
      >
        <span class="group-hover:underline">{title}</span>
        {
          badges.map((item) => (
            <div class="badge badge-secondary mx-2">{item}</div>
          ))
        }
      </h1>
      {
        descRich ? (
          <div class="py-1 text-1xl">
            <RichTextRenderer data={descRich} />
          </div>
        ) : (
          <p class="py-1 text-1xl">{desc}</p>
        )
      }
      {
        tags.length > 0 && (
          <div class="card-actions justify-end gap-2 mt-2">
            {tags.map((tag) => (
              <span class="badge badge-outline badge-sm">{tag.name}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
