---
import { PhFileText } from "phosphor-icons-astro";
import type { ResolvedLink } from "@/lib/types";

import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";

type Props = {
  profileImage: string;
  resumeDownloadUrl?: string;
  footerItems?: ResolvedLink[];
  name: string;
  role: string;
};

const { profileImage, resumeDownloadUrl, footerItems = [], name, role }: Props = Astro.props;
---

<div transition:persist transition:name="sidebar" class="drawer-side z-40 lg:overflow-visible">
  <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
  <aside
    id="sidebar"
    class="px-2 pt-2 h-auto min-h-full bg-base-200 text-base-content flex flex-col relative transition-[width,opacity,padding] duration-300 ease-in-out is-drawer-open:w-[19rem] is-drawer-close:w-0 is-drawer-close:overflow-hidden is-drawer-close:px-0 is-drawer-close:opacity-0 lg:is-drawer-close:w-20 lg:is-drawer-close:opacity-100 lg:is-drawer-close:px-2"
  >
    <div
      class="w-fit mx-auto mt-5 mb-3 lg:is-drawer-close:mt-3 lg:is-drawer-close:mb-1 transition-[margin] duration-300"
    >
      <a href="/">
        <div class="avatar transition ease-in-out hover:scale-[102%] block m-auto">
          <div
            class="w-[8.5rem] transition-[width] duration-300 ease-in-out lg:is-drawer-close:w-10"
          >
            {
              profileImage ? (
                <img
                  class="mask mask-circle w-full h-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                  width={300}
                  height={300}
                  src={profileImage}
                  alt="Profile"
                />
              ) : (
                <div class="mask mask-circle w-full h-full bg-base-300" aria-hidden="true" />
              )
            }
          </div>
        </div>
      </a>
    </div>

    <div class="text-center px-4 mb-2 is-drawer-close:hidden">
      <p class="text-lg font-bold text-base-content">{name}</p>
      <p class="text-[13px] text-base-content/70">{role}</p>
    </div>
    <div
      class="divider my-1 mx-4 is-drawer-close:hidden lg:is-drawer-close:flex lg:is-drawer-close:mx-1 transition-[margin] duration-300"
    >
    </div>

    <SideBarMenu />

    {
      resumeDownloadUrl && (
        <div class="mt-auto mb-4 px-4 overflow-hidden lg:is-drawer-close:px-1 transition-[padding] duration-300">
          <a
            href={resumeDownloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-block gap-2"
          >
            <PhFileText size={20} />
            <span class="whitespace-nowrap overflow-hidden is-drawer-close:hidden">
              Download My CV
            </span>
          </a>
        </div>
      )
    }
    <div class="flex flex-col gap-4 mb-6 lg:is-drawer-close:mb-3 transition-[margin] duration-300">
      <SideBarFooter items={footerItems} />
    </div>
  </aside>
</div>

<script is:inline>
  const STORAGE_KEY = "sidebar-expanded";

  const initSidebar = () => {
    const sidebar = document.getElementById("sidebar");
    const checkbox = document.getElementById("my-drawer");
    if (!(checkbox instanceof HTMLInputElement) || !sidebar) return;

    sidebar.style.transition = "none";

    if (!document.documentElement.dataset.sidebarInitialized) {
      const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
      if (isDesktop) {
        const saved = localStorage.getItem(STORAGE_KEY);
        checkbox.checked = saved !== "false";
      } else {
        checkbox.checked = false;
      }
      document.documentElement.dataset.sidebarInitialized = "true";

      checkbox.addEventListener("change", () => {
        if (window.matchMedia("(min-width: 1024px)").matches) {
          localStorage.setItem(STORAGE_KEY, String(checkbox.checked));
        }
      });
    }

    void sidebar.offsetHeight;
    sidebar.style.transition = "";
  };

  initSidebar();

  if (!document.documentElement.dataset.sidebarInitBound) {
    document.documentElement.dataset.sidebarInitBound = "true";

    document.addEventListener("astro:before-swap", (ev) => {
      const current = document.getElementById("my-drawer");
      const incoming = ev.newDocument.getElementById("my-drawer");
      if (current instanceof HTMLInputElement && incoming instanceof HTMLInputElement) {
        incoming.checked = current.checked;
      }
    });

    document.addEventListener("astro:page-load", initSidebar);
  }
</script>
