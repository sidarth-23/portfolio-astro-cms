---
import type { TableOfContentsItem } from "@sidshub/lexical/web";

type Props = {
  className?: string;
  items: TableOfContentsItem[];
};

const { className = "", items }: Props = Astro.props;
---

<nav
  aria-label="Table of contents"
  class={`rounded-xl border border-base-300 bg-base-200/70 p-4 backdrop-blur ${className}`.trim()}
  data-toc-root
>
  <div class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] opacity-70">On this page</div>

  <ul class="space-y-1">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          class={`block rounded-lg px-3 py-2 text-sm leading-6 opacity-70 transition-colors hover:bg-base-300/60 hover:opacity-100 ${item.depth === 3 ? "pl-7" : ""}`.trim()}
          data-toc-id={item.id}
          data-toc-link
        >
          {item.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
