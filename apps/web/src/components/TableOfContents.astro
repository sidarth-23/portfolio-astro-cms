---
import type { TableOfContentsItem } from "@sidshub/cms-editor/web/html";

type Props = {
  className?: string;
  items: TableOfContentsItem[];
};

const { className = "", items }: Props = Astro.props;
---

<nav
  aria-label="Table of contents"
  class={`text-sm ${className}`.trim()}
  data-toc-root
>
  <div class="mb-4 pb-3 border-b border-base-content/20 text-sm font-semibold opacity-80">On this page</div>

  <ul class="flex flex-col">
    {items.map((item) => {
      const indentClass = 
        item.depth === 2 ? "pl-3" : 
        item.depth === 3 ? "pl-8" : 
        "pl-12";
        
      return (
        <li>
          <a
            href={`#${item.id}`}
            class={`block border-l-[1.5px] border-transparent py-1.5 text-[0.85rem] leading-snug opacity-70 transition-colors hover:border-base-content/20 hover:opacity-100 ${indentClass}`.trim()}
            data-toc-id={item.id}
            data-toc-link
          >
            {item.text}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
