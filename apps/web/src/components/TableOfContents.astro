---
import type { TableOfContentsItem } from "@sidshub/lexical/web";

type Props = {
  className?: string;
  items: TableOfContentsItem[];
};

const { className = "", items }: Props = Astro.props;
---

<nav
  aria-label="Table of contents"
  class={`text-sm ${className}`.trim()}
  data-toc-root
>
  <div class="mb-3 text-sm font-medium opacity-70">On this page</div>

  <ul class="space-y-1.5">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          class={`block border-l border-transparent py-1 text-sm leading-6 opacity-70 transition-colors hover:border-base-content/20 hover:opacity-100 ${item.depth === 3 ? "pl-6" : "pl-3"}`.trim()}
          data-toc-id={item.id}
          data-toc-link
        >
          {item.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
