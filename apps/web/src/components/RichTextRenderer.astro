---
import { renderRichTextToHTML } from "@/lib/rich-text/html";
import type { CalloutVariantProfile, RichTextValue } from "@/lib/rich-text/html";
import { cmsMediaBaseUrl } from "@/lib/cms";
type Props = {
  className?: string;
  data?: RichTextValue | null;
  enableContainer?: boolean;
  calloutVariantProfile?: CalloutVariantProfile;
  mediaBaseUrl?: string;
};

const {
  className,
  data,
  enableContainer = false,
  calloutVariantProfile = "generic",
  mediaBaseUrl,
}: Props = Astro.props;
const resolvedMediaBaseUrl = mediaBaseUrl ?? cmsMediaBaseUrl;
const html = await renderRichTextToHTML(
  { className, data, enableContainer },
  {
    calloutVariantProfile,
    mediaBaseUrl: resolvedMediaBaseUrl,
  },
);
---

{html && <Fragment set:html={html} />}
