{
  "name": "@sidshub/cms",
  "private": true,
  "type": "module",
  "exports": {
    "./payload-config": "./src/payload.config.ts",
    "./payload-types": "./src/payload-types.ts"
  },
  "scripts": {
    "prepare:admin-artifacts": "cross-env NODE_OPTIONS=--no-deprecation SKIP_ENV_VALIDATION=1 tsx ../../node_modules/payload/bin.js --disable-transpile generate:importmap",
    "prebuild": "npm run prepare:admin-artifacts",
    "clean:next": "rm -rf .next",
    "dev": "npm run clean:next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3000",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@lexical/react": "0.41.0",
    "@payloadcms/db-mongodb": "3.82.1",
    "@payloadcms/email-resend": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/plugin-seo": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-s3": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@sidshub/icon-catalog": "workspace:*",
    "@t3-oss/env-core": "^0.13.4",
    "cross-env": "^7.0.3",
    "lexical": "0.41.0",
    "next": "^15.4.11",
    "payload": "3.82.1",
    "qs-esm": "8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-select": "5.9.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sidshub/dev-config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.24.0",
    "typescript": "^5.7.2"
  }
}
