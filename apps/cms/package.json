{
  "name": "@sidshub/cms",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:admin-artifacts": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "predev": "npm run prepare:admin-artifacts",
    "prebuild": "npm run prepare:admin-artifacts",
    "clean:next": "rm -rf .next",
    "dev": "npm run clean:next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3000",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.82.1",
    "@payloadcms/email-resend": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/plugin-seo": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-s3": "3.82.1",
    "@sidshub/cms-core": "workspace:*",
    "@sidshub/cms-lib-editor": "workspace:*",
    "@sidshub/cms-feature-emoji": "workspace:*",
    "@sidshub/cms-feature-footnotes": "workspace:*",
    "@sidshub/cms-plugin-deployment-log-view": "workspace:*",
    "@sidshub/cms-feature-markdown-paste": "workspace:*",
    "@sidshub/cms-plugin-og-image": "workspace:*",
    "@t3-oss/env-core": "^0.13.4",
    "cross-env": "^7.0.3",
    "next": "^15.4.11",
    "payload": "3.82.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sidshub/dev-config": "workspace:*",
    "eslint": "^9.24.0",
    "typescript": "^5.7.2"
  }
}
