# CMS runtime environment. Copy to apps/cms/.env for local development.
# Production values belong in Dokploy secrets, never in Git.

NODE_ENV=development
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
ASTRO_SITE_URL=http://localhost:4321
DATABASE_URI=mongodb://localhost:27017/payload

S3_BUCKET=sidshub-media
S3_REGION=us-east-1
# Leave unset for local MinIO; use the R2 S3 endpoint in production.
# S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/sidshub-media/
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

RESEND_API_KEY=replace-with-a-resend-api-key
EMAIL_FROM_ADDRESS=you@example.com
EMAIL_FROM_NAME=Sidshub
