{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "globalPassThroughEnv": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!Dockerfile", "!**/*.md", "!**/*.mdx"],
      "outputs": ["dist/**"]
    },
    "build:test": {
      "env": ["ASTRO_BUILD_CACHE_GLOBALS", "ASTRO_MOCK_CMS", "ASTRO_SITE_URL"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!Dockerfile", "!**/*.md", "!**/*.mdx"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "generate:types": {
      "env": [
        "PAYLOAD_SECRET",
        "PAYLOAD_PUBLIC_SERVER_URL",
        "DATABASE_URI",
        "RESEND_API_KEY",
        "EMAIL_FROM_ADDRESS",
        "EMAIL_FROM_NAME",
        "S3_BUCKET",
        "S3_REGION",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY"
      ],
      "outputs": ["src/payload-types.ts", "src/payload-generated-schema.ts"]
    },
    "@sidshub/web#build": {
      "dependsOn": ["@sidshub/icon-catalog#build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!Dockerfile", "!**/*.md", "!**/*.mdx"],
      "env": ["ASTRO_BUILD_CACHE_GLOBALS", "ASTRO_MOCK_CMS", "ASTRO_SITE_URL"],
      "outputs": ["dist/**"]
    },
    "@sidshub/cms#build": {
      "dependsOn": ["@sidshub/icon-catalog#build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!Dockerfile", "!**/*.md", "!**/*.mdx"],
      "env": [
        "ASTRO_SITE_URL",
        "PAYLOAD_SECRET",
        "PAYLOAD_PUBLIC_SERVER_URL",
        "DATABASE_URI",
        "RESEND_API_KEY",
        "EMAIL_FROM_ADDRESS",
        "EMAIL_FROM_NAME",
        "S3_BUCKET",
        "S3_REGION",
        "S3_ENDPOINT",
        "S3_PUBLIC_URL",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
