{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PAYLOAD_SECRET",
    "PAYLOAD_PUBLIC_SERVER_URL",
    "DATABASE_URI",
    "RESEND_API_KEY",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_FROM_NAME",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_AUTO_CREATE_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "CMS_READ_TOKEN",
    "WEB_DEPLOY_WEBHOOK_URL",
    "WEB_DEPLOY_BRANCH",
    "ASTRO_SITE_URL",
    "ASTRO_CMS_API_URL",
    "ASTRO_CMS_READ_TOKEN",
    "ASTRO_CMS_HEALTH_TIMEOUT_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "generate:types": {
      "outputs": ["src/payload-types.ts", "src/payload-generated-schema.ts"]
    }
  }
}
