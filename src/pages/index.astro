---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "@/lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout title="Home" sideBarActiveItemID="home">
  <div class="py-6">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Sidarth G</div>
    <div class="text-3xl py-3 font-bold">Full Stack Developer</div>
    <div class="py-2 space-y-2">
      <p class="text-lg">
        I'm just a random guy on the internet tinkering around with various
        tools around and having a fun time around. To feed myself, I do a job of
        a <strong>Backend developer</strong> with my tech stack around the Go language
        ecosystem.
      </p>
      <p class="text-lg">
        I started off my journey in the programming world with html and
        progressed all the way to javascript and the plethora of frameworks and
        libraries that the frontend/mixed development world has to offer.
        Eventually recently after a while, I made it to my current state to see
        what is backend. Currently I'm on the path to learning DevOps and
        Networking stuff.
      </p>
      <p class="text-lg font-bold pt-4">
        Life is short, enjoying it while I can :) PS
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://linkedin.com/in/sidarth-g" target="_blank">
        Let's connect!</a
      >
      <a href="/cv" class="btn btn-outline ml-5"> View My CV </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
