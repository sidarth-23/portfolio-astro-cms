# Production environment variable reference.
#
# Copy CMS variables to:  deployment/cms/.env
# Copy Web variables to:  deployment/web/.env
#
# Values NOT listed here are managed by the compose files themselves:
#   CMS compose:  DATABASE_URI, S3_ENDPOINT, NODE_ENV
#   Web compose:  HOST, PORT
#
# See docs/deployment/production/overview.md for the full setup guide.

# ═══════════════════════════════════════════════════════════════════════════════
# CMS STACK  →  deployment/cms/.env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Image Tag ────────────────────────────────────────────────────────────────
# Which GHCR image tag to pull for sidshub-cms.
# Use a branch name (main, staging) for rolling deployments or a SHA for pinned.
IMAGE_TAG=main

# ── CMS (Payload) ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=
CMS_READ_TOKEN=
PAYLOAD_PUBLIC_SERVER_URL=https://cms.sidshub.in
# Web app URL — used by the CMS for CORS/redirects.
ASTRO_SITE_URL=https://www.sidshub.in

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_BUCKET=sidshub-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Deploy Webhook ────────────────────────────────────────────────────────────
# Webhook URL that triggers a web rebuild when content is published in the CMS.
# Your hosting platform provides this URL (e.g. Dokploy auto-deploy webhook).
WEB_DEPLOY_WEBHOOK_URL=
WEB_DEPLOY_BRANCH=main

# ── Deployment Log View (optional) ───────────────────────────────────────────
# Enables a live deployment status card in the CMS admin dashboard.
# SITE_BUILD_HOOK_TYPE=dokploy
# SITE_BUILD_HOOK_URL=
# SITE_BUILD_HOOK_SECRET=
# SITE_BUILD_HOOK_DOKPLOY_APP_ID=
# SITE_BUILD_HOOK_DOKPLOY_PROJECT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# WEB APP  →  deployment/web/.env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Web App (Astro) ───────────────────────────────────────────────────────────
# These are passed as Docker build args when running `docker compose build`.
# The read token is used at build time only (SSG page fetching) and never stored
# in the final image or published to any registry.
ASTRO_SITE_URL=https://www.sidshub.in
ASTRO_CMS_API_URL=https://cms.sidshub.in/api
# Must match the value of CMS_READ_TOKEN in deployment/cms/.env.
ASTRO_CMS_READ_TOKEN=
