# Production environment variables for docker-compose.prod.yml.
#
# Values NOT listed here are managed by the compose file itself:
#   DATABASE_URI  — mongodb://mongodb:27017/payload  (compose service hostname)
#   S3_ENDPOINT   — http://minio:9000               (compose service hostname)
#   NODE_ENV      — production
#   HOST / PORT   — 0.0.0.0 / 4321  (astro-web)
#
# See docs/deployment.md for the full setup guide.

# ── Image Tag ────────────────────────────────────────────────────────────────
# Which GHCR image tag to pull for sidshub-cms and sidshub-web.
# Use a branch name (main, staging) for rolling deployments or a SHA for pinned.
IMAGE_TAG=main

# ── CMS (Payload) ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=
CMS_READ_TOKEN=
PAYLOAD_PUBLIC_SERVER_URL=https://cms.sidshub.in
ASTRO_SITE_URL=https://www.sidshub.in

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_BUCKET=sidshub-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Web App (Astro) ───────────────────────────────────────────────────────────
ASTRO_CMS_API_URL=https://cms.sidshub.in/api
ASTRO_CMS_READ_TOKEN=

# ── Deploy Webhook ────────────────────────────────────────────────────────────
# Webhook URL that triggers a web redeployment when content is published.
# Your hosting platform provides this URL (e.g. Dokploy auto-deploy webhook).
WEB_DEPLOY_WEBHOOK_URL=
WEB_DEPLOY_BRANCH=main

# ── Deployment Log View (optional) ───────────────────────────────────────────
# Enables a live deployment status card in the CMS admin dashboard.
# SITE_BUILD_HOOK_TYPE=dokploy
# SITE_BUILD_HOOK_URL=
# SITE_BUILD_HOOK_SECRET=
# SITE_BUILD_HOOK_DOKPLOY_APP_ID=
# SITE_BUILD_HOOK_DOKPLOY_PROJECT_ID=
