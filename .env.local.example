# Local tooling environment — copy to .env.local and fill in your values.
# Source this file from your shell profile when using local tooling.

# ── Optional local backing services ───────────────────────────────────────────
# These values are consumed by docker-compose.yml when running `task up`.
export S3_BUCKET="sidshub-media"
export S3_REGION="us-east-1"
export S3_ACCESS_KEY_ID="minioadmin"
export S3_SECRET_ACCESS_KEY="minioadmin"
export MINIO_CREATE_BUCKET_ON_STARTUP="true"
