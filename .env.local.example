# Local tooling environment — copy to .env.local and fill in your values.
# Source this file from your shell profile (e.g. ~/.bashrc or ~/.zshrc):
#
#   echo 'source ~/path/to/portfolio/.env.local' >> ~/.bashrc

# Dokploy — required for the dokploy-mcp MCP server in .mcp.json.
# Get your API key from: Dokploy → Account → API Keys
export DOKPLOY_URL=""
export DOKPLOY_API_KEY=""
