# Unified environment for local and production Docker Compose deployments.
# Copy to .env and replace every required value before production use.

# ── Image ─────────────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── CMS / Payload ─────────────────────────────────────────────────────────────
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
ASTRO_SITE_URL=http://localhost:4321

# ── Web build ─────────────────────────────────────────────────────────────────
ASTRO_CMS_API_URL=http://localhost:3000/api
CACHE_BUST=

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_BUCKET=sidshub-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_CREATE_BUCKET_ON_STARTUP=true

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ── Web deploy webhook ─────────────────────────────────────────────────────────
WEB_DEPLOY_WEBHOOK_URL=
WEB_DEPLOY_BRANCH=main
WEB_DEPLOY_TYPE=
WEB_DEPLOY_DOKPLOY_API_URL=
WEB_DEPLOY_DOKPLOY_API_KEY=
WEB_DEPLOY_DOKPLOY_COMPOSE_ID=
